#!/usr/bin/env python3
"""Thin executable bootstrap for herdr-task."""

import os
from pathlib import Path
import sys

# Ensure plugin/ directory is on sys.path
_candidates = [
    Path(__file__).resolve().parent.parent / "plugin",
    Path(os.path.expanduser("~/.config/herdr/tasks/plugin")),
]
for _cand in _candidates:
    if _cand.is_dir() and str(_cand) not in sys.path:
        sys.path.insert(0, str(_cand))
        break

# Re-export public API symbols for CLI and backwards-compatible loaders (e.g. test harnesses)
from herdr_task import (
    HerdrClient,
    IGNORED_JIRA_PREFIXES,
    TaskPaths,
    VALID_TASK_STATUSES,
    _extract_jira_key_from_text,
    _submit_interactive_task_form,
    apply_resource_target_to_draft,
    atomic_write_json,
    build_parser,
    classify_resource,
    cmd_add,
    cmd_automations,
    cmd_cleanup,
    cmd_create,
    cmd_current,
    cmd_focus,
    cmd_integrations,
    cmd_link,
    cmd_list,
    cmd_note,
    cmd_open,
    cmd_popup,
    cmd_popup_action,
    cmd_status,
    cmd_sync,
    cmd_sync_sidebar,
    cmd_unlink,
    cmd_update,
    cmd_worktree_add,
    cmd_worktree_branch,
    discover_integrations,
    dispatch_task_event,
    format_form_preview,
    interactive_resource_form,
    interactive_task_form,
    load_config,
    load_task,
    main,
    manage_task_resources,
    open_url_target,
    provision_worktree,
    query_integration_candidates,
    query_integration_field_options,
    remove_worktree,
    resolve_current_task_id,
    save_task,
    switch_worktree_branch,
    validate_git_branch,
)

if __name__ == "__main__":
    sys.exit(main())
