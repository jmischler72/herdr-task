SAFE_TASK_ID_RE = re.compile(r"^[A-Za-z0-9_][A-Za-z0-9._-]{0,127}$")
INVALID_BRANCH_CHARS_RE = re.compile(r"[\x00-\x20~^:?*\[\\]")
ALLOWED_OPEN_SCHEMES = {"http", "https", "slack"}


def now_iso() -> str:
    return datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def slugify(text: str, max_len: int = 48) -> str:
    s = re.sub(r"[^a-zA-Z0-9._-]+", "-", text.strip()).strip("-._")
    return s[:max_len].rstrip("-._") or "task"


def is_valid_task_id(task_id: str | None) -> bool:
    if not task_id or not isinstance(task_id, str):
        return False
    tid = task_id.strip()
    return bool(SAFE_TASK_ID_RE.match(tid) and ".." not in tid)


def validate_git_branch(branch: str) -> str:
    b = branch.strip()
    if (
        not b
        or b.startswith("-")
        or b.startswith("/")
        or b.endswith("/")
        or b.endswith(".")
        or b.endswith(".lock")
        or ".." in b
        or "@{" in b
        or "//" in b
        or INVALID_BRANCH_CHARS_RE.search(b)
    ):
        raise ValueError(f"Invalid git branch name: {branch!r}")
    return b


def resolve_bin(name: str, cfg: dict[str, Any] | None = None, cfg_key: str | None = None) -> str:
    if cfg and cfg_key:
        configured = cfg.get(cfg_key)
        if isinstance(configured, str) and configured.strip():
            cand = os.path.expanduser(configured.strip())
            if shutil.which(cand) or os.path.exists(cand):
                return cand
    found = shutil.which(name)
    if found:
        return found
    for prefix in ("/opt/homebrew/bin", "/usr/local/bin"):
        fallback = os.path.join(prefix, name)
        if os.path.exists(fallback):
            return fallback
    return name


def extract_cmd_binary(cmd_str: str) -> str | None:
    try:
        parts = shlex.split(cmd_str.strip())
    except ValueError:
        parts = cmd_str.strip().split()
    return parts[0] if parts else None


# ---------------------------------------------------------------------------
# Storage & Task Resolution
# ---------------------------------------------------------------------------

class TaskPaths:
    def __init__(self, base_dir: str | Path | None = None) -> None:
        raw = base_dir or os.environ.get("HERDR_TASKS_DIR") or "~/.config/herdr/tasks"
        self.base = Path(os.path.expanduser(str(raw))).resolve()
        self.archive = self.base / "archive"
        self.user_automations = self.base / "automations"
        self.user_integrations = self.base / "integrations"
        self.lock_file = self.base / ".lock"
        self.config_file = self.base / "config.json"

    def ensure_dirs(self) -> None:
        self.base.mkdir(parents=True, exist_ok=True)
        self.archive.mkdir(parents=True, exist_ok=True)

    def automation_search_dirs(self) -> list[Path]:
        dirs: list[Path] = []
        script_rel = Path(__file__).resolve().parent.parent / "automations"
        builtin_plugin = Path(os.path.expanduser("~/.config/herdr/tasks/plugin/automations"))
        for cand in (script_rel, builtin_plugin, self.base / "plugin" / "automations", self.user_automations):
            try:
                resolved = cand.resolve()
                if resolved.is_dir() and resolved not in dirs:
                    dirs.append(resolved)
            except Exception:
                continue
        return dirs

    def integration_search_dirs(self) -> list[Path]:
        dirs: list[Path] = []
        script_rel = Path(__file__).resolve().parent.parent / "integrations"
        builtin_plugin = Path(os.path.expanduser("~/.config/herdr/tasks/plugin/integrations"))
        for cand in (script_rel, builtin_plugin, self.base / "plugin" / "integrations", self.user_integrations):
            try:
                resolved = cand.resolve()
                if resolved.is_dir() and resolved not in dirs:
                    dirs.append(resolved)
            except Exception:
                continue
        return dirs

    def _safe_json_path(self, directory: Path, task_id: str) -> Path:
        tid = task_id.strip()
        if not is_valid_task_id(tid):
            raise ValueError(f"Invalid task ID: {task_id!r}")
        resolved_dir = directory.resolve()
        candidate = (resolved_dir / f"{tid}.json").resolve()
        if candidate.parent != resolved_dir:
            raise ValueError(f"Task ID escapes storage directory: {task_id!r}")
        return candidate

    def task_file(self, task_id: str) -> Path:
        return self._safe_json_path(self.base, task_id)

    def archive_file(self, task_id: str) -> Path:
        return self._safe_json_path(self.archive, task_id)


def load_config(paths: TaskPaths) -> dict[str, Any]:
    paths.ensure_dirs()
    cfg = json.loads(json.dumps(DEFAULT_CONFIG))
    if paths.config_file.exists():
        try:
            user_cfg = json.loads(paths.config_file.read_text(encoding="utf-8"))
            if isinstance(user_cfg, dict):
                user_autos = user_cfg.get("automations")
                user_integs = user_cfg.get("integrations")
                for k, v in user_cfg.items():
                    if k not in ("automations", "integrations"):
                        cfg[k] = v
                if isinstance(user_autos, dict):
                    cfg_autos = cfg.setdefault("automations", {})
                    for auto_id, auto_conf in user_autos.items():
                        if isinstance(auto_conf, dict):
                            cfg_autos.setdefault(auto_id, {}).update(auto_conf)
                        else:
                            cfg_autos[auto_id] = auto_conf
                if isinstance(user_integs, dict):
                    cfg_integs = cfg.setdefault("integrations", {})
                    for integ_id, integ_conf in user_integs.items():
                        if isinstance(integ_conf, dict):
                            cfg_integs.setdefault(integ_id, {}).update(integ_conf)
                        else:
                            cfg_integs[integ_id] = integ_conf
        except Exception:
            pass
    env_wt = os.environ.get("HERDR_WORKTREES_DIR", "").strip()
    if env_wt:
        cfg["worktrees_root"] = env_wt
    return cfg


# ---------------------------------------------------------------------------
# Modular Lifecycle Automation Engine
# ---------------------------------------------------------------------------

def discover_automations(paths: TaskPaths, cfg: dict[str, Any]) -> list[dict[str, Any]]:
    discovered_by_id: dict[str, dict[str, Any]] = {}
    user_auto_cfg = cfg.get("automations") if isinstance(cfg.get("automations"), dict) else {}

    for folder in paths.automation_search_dirs():
        for py_file in sorted(folder.glob("*.py")):
            if py_file.name.startswith("_"):
                continue
            mod_name = f"herdr_task_auto_{py_file.stem}"
            try:
                spec = importlib.util.spec_from_file_location(mod_name, str(py_file))
                if not spec or not spec.loader:
                    continue
                mod = importlib.util.module_from_spec(spec)
                spec.loader.exec_module(mod)
            except Exception:
                continue

            handle_fn = getattr(mod, "handle_event", None)
            if not callable(handle_fn):
                continue

            auto_id = str(getattr(mod, "AUTOMATION_ID", py_file.stem)).strip()
            description = str(getattr(mod, "DESCRIPTION", "")).strip()
            events = tuple(getattr(mod, "EVENTS", ()))
            default_settings = getattr(mod, "DEFAULT_SETTINGS", {})
            settings: dict[str, Any] = (
                json.loads(json.dumps(default_settings)) if isinstance(default_settings, dict) else {}
            )

            ovr = user_auto_cfg.get(auto_id)
            if isinstance(ovr, bool):
                settings["enabled"] = ovr
            elif isinstance(ovr, dict):
                for sk, sv in ovr.items():
                    if sk == "status_map" and isinstance(sv, dict) and isinstance(settings.get("status_map"), dict):
                        settings["status_map"].update(sv)
                    else:
                        settings[sk] = sv

            discovered_by_id[auto_id] = {
                "id": auto_id,
                "description": description,
                "events": list(events),
                "enabled": bool(settings.get("enabled", True)),
                "path": str(py_file),
                "settings": settings,
                "module": mod,
            }

    return list(discovered_by_id.values())


def dispatch_automation_event(
    event: str,
    task: dict[str, Any],
    paths: TaskPaths,
    cfg: dict[str, Any],
    **extra_context: Any,
) -> tuple[bool, list[str]]:
    automations = discover_automations(paths, cfg)
    any_modified = False
    messages: list[str] = []

    context: dict[str, Any] = {
        "event": event,
        "task": task,
        "paths": paths,
        "config": cfg,
        **extra_context,
    }

    for auto in automations:
        if not auto["enabled"]:
            continue
        if auto["events"] and event not in auto["events"]:
            continue
        try:
            res = auto["module"].handle_event(event, context, auto["settings"])
            if isinstance(res, dict):
                if res.get("task_modified"):
                    any_modified = True
                for m in res.get("messages") or []:
                    if m:
                        messages.append(f"[{auto['id']}] {m}")
        except Exception as e:
            messages.append(f"[{auto['id']}] Error handling {event}: {e}")

    return any_modified, messages


# ---------------------------------------------------------------------------
# Modular Integration & Predefined Value Engine
# ---------------------------------------------------------------------------

def discover_integrations(paths: TaskPaths, cfg: dict[str, Any]) -> list[dict[str, Any]]:
    """
    Discovers modular integrations from `integrations/*.py` and `automations/*.py`
    that expose `provide_candidates`, `provide_field_options`, or `enrich_resource`.
    """
    discovered_by_id: dict[str, dict[str, Any]] = {}
    user_auto_cfg = cfg.get("automations") if isinstance(cfg.get("automations"), dict) else {}
    user_integ_cfg = cfg.get("integrations") if isinstance(cfg.get("integrations"), dict) else {}

    search_dirs: list[Path] = []
    for d in (*paths.automation_search_dirs(), *paths.integration_search_dirs()):
        if d not in search_dirs:
            search_dirs.append(d)

    for folder in search_dirs:
        for py_file in sorted(folder.glob("*.py")):
            if py_file.name.startswith("_"):
                continue
            mod_name = f"herdr_task_integ_{py_file.stem}"
            try:
                spec = importlib.util.spec_from_file_location(mod_name, str(py_file))
                if not spec or not spec.loader:
                    continue
                mod = importlib.util.module_from_spec(spec)
                spec.loader.exec_module(mod)
            except Exception:
                continue

            cand_fn = getattr(mod, "provide_candidates", None)
            opt_fn = getattr(mod, "provide_field_options", None)
            enrich_fn = getattr(mod, "enrich_resource", None)
            if not any(callable(fn) for fn in (cand_fn, opt_fn, enrich_fn)):
                continue

            integ_id = str(
                getattr(mod, "INTEGRATION_ID", None)
                or getattr(mod, "AUTOMATION_ID", None)
                or py_file.stem
            ).strip()
            auto_id = str(getattr(mod, "AUTOMATION_ID", integ_id)).strip()
            description = str(getattr(mod, "DESCRIPTION", "")).strip()
            default_settings = getattr(mod, "DEFAULT_SETTINGS", {})
            settings: dict[str, Any] = (
                json.loads(json.dumps(default_settings)) if isinstance(default_settings, dict) else {}
            )

            for ovr_source in (user_auto_cfg.get(auto_id), user_auto_cfg.get(integ_id), user_integ_cfg.get(integ_id)):
                if isinstance(ovr_source, bool):
                    settings["enabled"] = ovr_source
                elif isinstance(ovr_source, dict):
                    for sk, sv in ovr_source.items():
                        if sk == "status_map" and isinstance(sv, dict) and isinstance(settings.get("status_map"), dict):
                            settings["status_map"].update(sv)
                        else:
                            settings[sk] = sv

            caps: list[str] = []
            if callable(cand_fn):
                caps.append("candidates")
            if callable(opt_fn):
                caps.append("field_options")
            if callable(enrich_fn):
                caps.append("enrich_resource")

            discovered_by_id[integ_id] = {
                "id": integ_id,
                "description": description,
                "capabilities": caps,
                "enabled": bool(settings.get("enabled", True)),
                "path": str(py_file),
                "settings": settings,
                "module": mod,
            }

    return list(discovered_by_id.values())


def query_integration_candidates(
    kind: str,
    paths: TaskPaths,
    cfg: dict[str, Any],
    **extra_context: Any,
) -> list[dict[str, Any]]:
    integrations = discover_integrations(paths, cfg)
    all_tasks = extra_context.pop("all_tasks", None)
    if all_tasks is None:
        all_tasks = list_all_tasks(paths, include_archived=True)

    context: dict[str, Any] = {
        "kind": kind,
        "paths": paths,
        "config": cfg,
        "all_tasks": all_tasks,
        **extra_context,
    }

    out: list[dict[str, Any]] = []
    seen_values: set[str] = set()
    for integ in integrations:
        if not integ["enabled"]:
            continue
        fn = getattr(integ["module"], "provide_candidates", None)
        if not callable(fn):
            continue
        try:
            items = fn(kind, context, integ["settings"]) or []
            for item in items:
                if not isinstance(item, dict):
                    continue
                val = str(item.get("value") or "").strip()
                if not val or val in seen_values:
                    continue
                seen_values.add(val)
                item_copy = dict(item)
                item_copy.setdefault("integration_id", integ["id"])
                out.append(item_copy)
        except Exception:
            continue
    return out


def query_integration_field_options(
    field: str,
    paths: TaskPaths,
    cfg: dict[str, Any],
    **extra_context: Any,
) -> list[dict[str, Any]]:
    integrations = discover_integrations(paths, cfg)
    context: dict[str, Any] = {
        "field": field,
        "paths": paths,
        "config": cfg,
        **extra_context,
    }

    out: list[dict[str, Any]] = []
    seen_values: set[str] = set()
    for integ in integrations:
        if not integ["enabled"]:
            continue
        fn = getattr(integ["module"], "provide_field_options", None)
        if not callable(fn):
            continue
        try:
            items = fn(field, context, integ["settings"]) or []
            for item in items:
                if not isinstance(item, dict):
                    continue
                val = str(item.get("value") or "").strip()
                if not val or val in seen_values:
                    continue
                seen_values.add(val)
                item_copy = dict(item)
                item_copy.setdefault("integration_id", integ["id"])
                out.append(item_copy)
        except Exception:
            continue
    return out


def enrich_draft_resource_via_integrations(
    res: dict[str, Any],
    paths: TaskPaths,
    cfg: dict[str, Any],
    task: dict[str, Any] | None = None,
) -> list[str]:
    integrations = discover_integrations(paths, cfg)
    context: dict[str, Any] = {
        "resource": res,
        "task": task or {},
        "paths": paths,
        "config": cfg,
    }
    messages: list[str] = []
    for integ in integrations:
        if not integ["enabled"]:
            continue
        fn = getattr(integ["module"], "enrich_resource", None)
        if not callable(fn):
            continue
        try:
            ret = fn(res, context, integ["settings"])
            if isinstance(ret, dict) and ret.get("message"):
                messages.append(f"[{integ['id']}] {ret['message']}")
        except Exception:
            continue
    return messages


@contextmanager
def task_store_lock(paths: TaskPaths):
    paths.ensure_dirs()
    fd = os.open(str(paths.lock_file), os.O_CREAT | os.O_RDWR, 0o600)
    try:
        fcntl.flock(fd, fcntl.LOCK_EX)
        yield
    finally:
        try:
            fcntl.flock(fd, fcntl.LOCK_UN)
        finally:
            os.close(fd)


def atomic_write_json(target: Path, data: dict[str, Any]) -> None:
    target.parent.mkdir(parents=True, exist_ok=True)
    fd, tmp_path = tempfile.mkstemp(prefix=f".{target.name}.", dir=str(target.parent))
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as f:
            json.dump(data, f, indent=2, ensure_ascii=False)
            f.write("\n")
            f.flush()
            os.fsync(f.fileno())
        os.replace(tmp_path, str(target))
    except Exception:
        if os.path.exists(tmp_path):
            os.unlink(tmp_path)
        raise


def load_task(paths: TaskPaths, task_id: str, include_archived: bool = False) -> dict[str, Any] | None:
    if not is_valid_task_id(task_id):
        return None
    f = paths.task_file(task_id)
    if f.exists():
        try:
            data = json.loads(f.read_text(encoding="utf-8"))
            if isinstance(data, dict):
                if data.get("status") == "archived" and not include_archived:
                    return None
                return data
        except Exception:
            return None
    if include_archived:
        af = paths.archive_file(task_id)
        if af.exists():
            try:
                return json.loads(af.read_text(encoding="utf-8"))
            except Exception:
                return None
    return None


def list_all_tasks(paths: TaskPaths, include_archived: bool = False) -> list[dict[str, Any]]:
    paths.ensure_dirs()
    tasks: list[dict[str, Any]] = []
    seen_ids: set[str] = set()
    for p in sorted(paths.base.glob("*.json")):
        if p.name == "config.json":
            continue
        try:
            data = json.loads(p.read_text(encoding="utf-8"))
            if isinstance(data, dict) and is_valid_task_id(data.get("id")):
                if data.get("status") == "archived" and not include_archived:
                    continue
                tasks.append(data)
                seen_ids.add(data["id"])
        except Exception:
            continue
    if include_archived:
        for p in sorted(paths.archive.glob("*.json")):
            try:
                data = json.loads(p.read_text(encoding="utf-8"))
                if isinstance(data, dict) and is_valid_task_id(data.get("id")) and data["id"] not in seen_ids:
                    tasks.append(data)
                    seen_ids.add(data["id"])
            except Exception:
                continue
    tasks.sort(key=lambda t: t.get("updated_at") or t.get("created_at") or "", reverse=True)
    return tasks


def collect_active_worktree_paths(paths: TaskPaths, exclude_task_id: str | None = None) -> set[str]:
    used: set[str] = set()
    for t in list_all_tasks(paths, include_archived=False):
        if exclude_task_id and t.get("id") == exclude_task_id:
            continue
        for wt in t.get("worktrees", []):
            wp = wt.get("worktree_path")
            if wp:
                used.add(os.path.realpath(wp))
    return used


def resolve_current_task_id(
    paths: TaskPaths,
    explicit_task_id: str | None = None,
    include_archived: bool = False,
) -> str | None:
    if explicit_task_id:
        exp_clean = explicit_task_id.strip()
        if is_valid_task_id(exp_clean):
            if paths.task_file(exp_clean).exists():
                return exp_clean
            if include_archived and paths.archive_file(exp_clean).exists():
                return exp_clean
        all_tasks = list_all_tasks(paths, include_archived=include_archived)
        exp_low = exp_clean.lower()
        for t in all_tasks:
            prev_lows = [str(p).lower() for p in (t.get("previous_ids") or [])]
            if t["id"].lower() == exp_low or exp_low in prev_lows:
                return t["id"]
        for t in all_tasks:
            if t["id"].lower().startswith(exp_low):
                return t["id"]
        return exp_clean if is_valid_task_id(exp_clean) else None

    if os.environ.get("HERDR_PILOT_MODE") == "new_task":
        return None

    tasks = list_all_tasks(paths)

    env_task_id = os.environ.get("HERDR_TASK_ID", "").strip()
    if env_task_id:
        if is_valid_task_id(env_task_id) and paths.task_file(env_task_id).exists():
            return env_task_id
        env_low = env_task_id.lower()
        for t in tasks:
            prev_lows = [str(p).lower() for p in (t.get("previous_ids") or [])]
            if t["id"].lower() == env_low or env_low in prev_lows:
                return t["id"]

    env_ws_id = os.environ.get("HERDR_WORKSPACE_ID", "").strip()
    if env_ws_id:
        for t in tasks:
            if t.get("workspace_id") == env_ws_id:
                return t["id"]
            for wt in t.get("worktrees", []):
                if wt.get("workspace_id") == env_ws_id:
                    return t["id"]

    try:
        cwd = os.path.realpath(os.getcwd())
    except Exception:
        cwd = os.getcwd()

    for t in tasks:
        for wt in t.get("worktrees", []):
            wt_path = wt.get("worktree_path")
            if wt_path:
                real_wt = os.path.realpath(wt_path)
                if cwd == real_wt or cwd.startswith(real_wt + os.sep):
                    return t["id"]
    return None


def discover_available_repos(cfg: dict[str, Any]) -> list[str]:
    repos: list[str] = []
    for root in cfg.get("repo_roots", []):
        rp = Path(os.path.expanduser(root))
        if rp.is_dir():
            try:
                for child in sorted(rp.iterdir()):
                    if child.is_dir() and (child / ".git").exists() and child.name not in repos:
                        repos.append(child.name)
            except Exception:
                pass
    return repos


# ---------------------------------------------------------------------------
# Resource Classification & Upsert
# ---------------------------------------------------------------------------

JIRA_KEY_RE = re.compile(r"^([A-Z][A-Z0-9_]{1,15}-\d+)$")
JIRA_URL_RE = re.compile(r"/browse/([A-Z][A-Z0-9_]{1,15}-\d+)")
GH_PR_URL_RE = re.compile(r"github\.com/([^/]+)/([^/]+)/pull/(\d+)")
GH_ISSUE_URL_RE = re.compile(r"github\.com/([^/]+)/([^/]+)/issues/(\d+)")
GH_SHORT_RE = re.compile(r"^(?:([A-Za-z0-9._-]+)/)?([A-Za-z0-9._-]+)#(\d+)$")
GH_REMOTE_ORG_RE = re.compile(r"github\.com[:/]([^/]+)/([^/.]+?)(?:\.git)?$")
SLACK_URL_RE = re.compile(r"https?://([a-zA-Z0-9_-]+)\.slack\.com/archives/([A-Z0-9]+)/p(\d+)")

IGNORED_JIRA_PREFIXES = {
    "UTF", "SHA", "AES", "RSA", "TLS", "SSL", "HTTP", "HTTPS", "IPV",
    "CVE", "ISO", "RFC", "PEP", "PR", "GH", "V1", "V2", "V3", "RC",
    "ARM", "AMD", "X86", "JDK", "NODE", "CPU", "GPU", "RAM", "SQL",
}


def _extract_jira_key_from_text(text: str | None) -> str | None:
    if not text:
        return None
    for m_jk in re.finditer(r"\b([A-Z][A-Z0-9_]{1,15})-(\d+)\b", text):
        prefix = m_jk.group(1)
        if prefix not in IGNORED_JIRA_PREFIXES:
            return f"{prefix}-{m_jk.group(2)}"
    return None


def _infer_github_org_for_repo(repo_name: str, cfg: dict[str, Any]) -> str | None:
    try:
        _, repo_path = resolve_repo_path(repo_name, cfg)
        res = subprocess.run(
            ["git", "-C", str(repo_path), "remote", "get-url", "origin"],
            capture_output=True,
            text=True,
            timeout=2.0,
            check=False,
        )
        if res.returncode == 0 and res.stdout.strip():
            m = GH_REMOTE_ORG_RE.search(res.stdout.strip())
            if m:
                return m.group(1)
    except Exception:
        pass
    return None


def fetch_github_pr_metadata(org: str, repo: str, num: str) -> dict[str, Any]:
    """Zero-AI-token GitHub PR enrichment via `gh pr view`."""
    gh_bin = resolve_bin("gh")
    if not (shutil.which(gh_bin) or os.path.exists(gh_bin)):
        return {}
    try:
        res = subprocess.run(
            [
                gh_bin, "pr", "view", str(num),
                "-R", f"{org}/{repo}",
                "--json", "title,headRefName,state,isDraft,body",
            ],
            capture_output=True,
            text=True,
            timeout=4.0,
            check=False,
        )
        if res.returncode != 0 or not res.stdout.strip():
            return {}
        data = json.loads(res.stdout)
        pr_title = (data.get("title") or "").strip()
        head_ref = (data.get("headRefName") or "").strip()
        is_draft = bool(data.get("isDraft"))
        raw_state = (data.get("state") or "OPEN").upper()
        pr_status = "DRAFT" if is_draft and raw_state == "OPEN" else raw_state
        body = (data.get("body") or "").strip()

        summary_lines: list[str] = []
        for line in body.splitlines():
            clean = line.strip()
            if not clean or clean.startswith(("<!--", "#", "---", "- [ ]", "- [x]")):
                continue
            summary_lines.append(clean)
            if len(summary_lines) >= 2:
                break
        body_snip = " ".join(summary_lines)[:180]
        summary = f"{pr_title} (branch: {head_ref})" if head_ref else pr_title
        if body_snip and body_snip.lower() != pr_title.lower():
            summary = f"{summary} — {body_snip}"

        jira_key = None
        for text_cand in (pr_title, head_ref, body[:400]):
            jira_key = _extract_jira_key_from_text(text_cand)
            if jira_key:
                break

        return {
            "title": pr_title,
            "branch": head_ref,
            "status": pr_status,
            "summary": summary,
            "jira_key": jira_key,
            "repo": repo,
            "org": org,
        }
    except Exception:
        return {}


def classify_resource(
    raw_input: str,
    cfg: dict[str, Any],
    category: str | None = None,
    provider: str | None = None,
    label: str | None = None,
    status: str | None = None,
    summary: str | None = None,
    added_by: str | None = None,
    metadata: dict[str, Any] | None = None,
    fetch_remote: bool = True,
) -> dict[str, Any]:
    val = raw_input.strip()
    det_cat = category
    det_prov = provider
    ref = val
    url = val
    meta_out: dict[str, Any] = dict(metadata or {})
    explicit_label = bool(label and label.strip())
    default_label: str | None = None

    m_jira_key = JIRA_KEY_RE.match(val)
    m_jira_url = JIRA_URL_RE.search(val)
    m_gh_pr = GH_PR_URL_RE.search(val)
    m_gh_issue = GH_ISSUE_URL_RE.search(val)
    m_gh_short = GH_SHORT_RE.match(val)
    m_slack = SLACK_URL_RE.search(val)

    if m_jira_key:
        key = m_jira_key.group(1)
        det_cat = det_cat or "ticket"
        det_prov = det_prov or "jira"
        ref = key
        base = cfg.get("jira_base_url", DEFAULT_CONFIG["jira_base_url"]).rstrip("/")
        url = f"{base}/{key}"
        default_label = key
    elif m_jira_url:
        key = m_jira_url.group(1)
        det_cat = det_cat or "ticket"
        det_prov = det_prov or "jira"
        ref = key
        default_label = key
    elif m_gh_pr or m_gh_short:
        if m_gh_pr:
            org, repo, num = m_gh_pr.group(1), m_gh_pr.group(2), m_gh_pr.group(3)
        else:
            assert m_gh_short is not None
            org = m_gh_short.group(1) or meta_out.get("org") or _infer_github_org_for_repo(m_gh_short.group(2), cfg)
            repo, num = m_gh_short.group(2), m_gh_short.group(3)
            url = f"https://github.com/{org}/{repo}/pull/{num}" if org else ""
        det_cat = det_cat or "pull_request"
        det_prov = det_prov or "github"
        ref = f"{repo}#{num}"
        meta_out.setdefault("repo", repo)
        if org:
            meta_out.setdefault("org", org)
        default_label = f"{repo} #{num}"
        if org and fetch_remote and not (label and status and summary and meta_out.get("branch")):
            pr_meta = fetch_github_pr_metadata(org, repo, num)
            if pr_meta:
                if not label and pr_meta.get("title"):
                    label = f"{repo}#{num}: {pr_meta['title']}"
                    explicit_label = True
                if not status and pr_meta.get("status"):
                    status = pr_meta["status"]
                if not summary and pr_meta.get("summary"):
                    summary = pr_meta["summary"]
                if pr_meta.get("branch"):
                    meta_out["branch"] = pr_meta["branch"]
                if pr_meta.get("title"):
                    meta_out["pr_title"] = pr_meta["title"]
                if pr_meta.get("jira_key"):
                    meta_out["jira_key"] = pr_meta["jira_key"]
    elif m_gh_issue:
        org, repo, num = m_gh_issue.group(1), m_gh_issue.group(2), m_gh_issue.group(3)
        det_cat = det_cat or "issue"
        det_prov = det_prov or "github"
        ref = f"{repo}#{num}"
        meta_out.setdefault("repo", repo)
        meta_out.setdefault("org", org)
        default_label = f"{repo} issue #{num}"
    elif m_slack:
        team_slug, chan_id, ts_raw = m_slack.group(1), m_slack.group(2), m_slack.group(3)
        det_cat = det_cat or "conversation"
        det_prov = det_prov or "slack"
        ts_dot = f"{ts_raw[:-6]}.{ts_raw[-6:]}" if len(ts_raw) > 6 else ts_raw
        ref = f"slack://channel?id={chan_id}&message={ts_dot}"
        url = ref
        default_label = f"Slack thread ({team_slug} / {chan_id})"
    elif any(k in val.lower() for k in ("securityhub", "grafana", "datadoghq", "sentry.io")):
        det_cat = det_cat or "alert"
        det_prov = det_prov or "alert"
        default_label = "Alert / Monitor"
    elif any(d in val.lower() for d in ("notion.so", "notion.site", "confluence", "atlassian.net/wiki", "figma.com", "docs.google.com")):
        det_cat = det_cat or "doc"
        det_prov = det_prov or "doc"
        default_label = "Documentation / Spec"
    else:
        det_cat = det_cat or "custom"
        det_prov = det_prov or ("web" if val.startswith(("http://", "https://")) else "custom")
        parsed = urlparse(val)
        default_label = f"{parsed.netloc}{parsed.path}" if parsed.netloc else val

    return {
        "id": f"res_{uuid.uuid4().hex[:8]}",
        "category": det_cat,
        "provider": det_prov,
        "ref": ref,
        "url": url,
        "label": label or default_label or ref,
        "_explicit_label": explicit_label,
        "status": status,
        "summary": summary,
        "metadata": meta_out,
        "added_by": added_by or os.environ.get("USER") or "user",
        "updated_at": now_iso(),
    }


def upsert_resource(task: dict[str, Any], new_res: dict[str, Any]) -> dict[str, Any]:
    explicit_label = bool(new_res.pop("_explicit_label", False))
    resources = task.setdefault("resources", [])
    for existing in resources:
        same_ref = existing.get("ref") and existing.get("ref") == new_res.get("ref")
        same_url = existing.get("url") and existing.get("url") == new_res.get("url")
        if same_ref or same_url:
            for k in ("category", "provider", "status", "summary", "added_by"):
                if new_res.get(k) is not None:
                    existing[k] = new_res[k]
            if new_res.get("label") is not None:
                if explicit_label or not existing.get("label") or existing.get("label") == existing.get("ref"):
                    existing["label"] = new_res["label"]
            if new_res.get("url") and new_res["url"].startswith(("http://", "https://", "slack://")):
                existing["url"] = new_res["url"]
            if new_res.get("metadata"):
                existing.setdefault("metadata", {}).update(new_res["metadata"])
            existing["updated_at"] = now_iso()
            return existing
    resources.append(new_res)
    return new_res


# ---------------------------------------------------------------------------
# Git Worktree Management (Task-Scoped Paths, In-Place Branch Switching)
# ---------------------------------------------------------------------------

def resolve_repo_path(repo: str, cfg: dict[str, Any]) -> tuple[str, Path]:
    expanded = Path(os.path.expanduser(repo))
    if expanded.is_dir() and ((expanded / ".git").exists() or (expanded / "HEAD").exists()):
        return expanded.name, expanded.resolve()

    for root in cfg.get("repo_roots", []):
        candidate = Path(os.path.expanduser(root)) / repo
        if candidate.is_dir() and (candidate / ".git").exists():
            return candidate.name, candidate.resolve()

    raise ValueError(f"Repository '{repo}' not found in configured repo_roots: {cfg.get('repo_roots')}")


def list_git_worktrees(repo_path: Path) -> list[dict[str, str]]:
    res = subprocess.run(
        ["git", "-C", str(repo_path), "worktree", "list", "--porcelain"],
        capture_output=True,
        text=True,
        check=False,
    )
    if res.returncode != 0:
        return []
    entries: list[dict[str, str]] = []
    current: dict[str, str] = {}
    for line in res.stdout.splitlines():
        if not line.strip():
            if current:
                entries.append(current)
                current = {}
            continue
        if line.startswith("worktree "):
            current["path"] = line[len("worktree "):].strip()
        elif line.startswith("branch refs/heads/"):
            current["branch"] = line[len("branch refs/heads/"):].strip()
        elif line == "detached":
            current["detached"] = "true"
    if current:
        entries.append(current)
    return entries


def git_ref_exists(repo_path: Path, ref: str) -> bool:
    res = subprocess.run(
        ["git", "-C", str(repo_path), "show-ref", "--verify", "--quiet", ref],
        capture_output=True,
        check=False,
    )
    return res.returncode == 0


def detect_default_base_ref(repo_path: Path) -> str:
    for candidate in ("refs/remotes/origin/main", "refs/remotes/origin/master", "refs/heads/main", "refs/heads/master"):
        if git_ref_exists(repo_path, candidate):
            return candidate.replace("refs/remotes/", "").replace("refs/heads/", "")
    return "HEAD"


def check_worktree_safety(worktree_path: str) -> dict[str, Any]:
    p = Path(worktree_path)
    if not p.exists():
        return {"exists": False, "clean": True, "dirty_files": []}

    status_res = subprocess.run(
        ["git", "-C", str(p), "status", "--porcelain"],
        capture_output=True,
        text=True,
        check=False,
    )
    dirty_lines = [line for line in status_res.stdout.splitlines() if line.strip()]
    return {
        "exists": True,
        "clean": len(dirty_lines) == 0,
        "dirty_files": dirty_lines,
    }


def _fetch_branch_if_needed(git_dir: Path, repo_path: Path, branch: str) -> None:
    if (
        not git_ref_exists(repo_path, f"refs/heads/{branch}")
        and not git_ref_exists(repo_path, f"refs/remotes/origin/{branch}")
    ):
        try:
            subprocess.run(
                ["git", "-C", str(git_dir), "fetch", "--quiet", "origin", branch],
                capture_output=True,
                timeout=8.0,
                check=False,
            )
        except Exception:
            pass


def _detach_worktree_if_clean(wt_path: str) -> bool:
    if not check_worktree_safety(wt_path)["clean"]:
        return False
    res = subprocess.run(
        ["git", "-C", wt_path, "checkout", "--detach", "--quiet"],
        capture_output=True,
        check=False,
    )
    return res.returncode == 0


def switch_worktree_branch(
    wt: dict[str, Any],
    target_branch: str,
    cfg: dict[str, Any],
    task_id: str | None = None,
    force: bool = False,
) -> tuple[bool, str]:
    """
    Switches a registered task worktree to `target_branch` in-place via `git checkout`.
    Never moves the worktree directory on disk, so running panes keep a valid $PWD.
    """
    try:
        target_branch = validate_git_branch(target_branch)
    except ValueError as e:
        return False, str(e)

    repo_name = wt["repo"]
    repo_path = Path(wt.get("repo_path") or "")
    if not repo_path.exists():
        _, repo_path = resolve_repo_path(repo_name, cfg)
        wt["repo_path"] = str(repo_path)

    cur_wt_path = Path(wt.get("worktree_path") or "")
    if not cur_wt_path.exists():
        info = ensure_git_worktree(repo_name, target_branch, cfg, task_id=task_id or wt.get("task_id"))
        wt["worktree_path"] = info["worktree_path"]
        wt["branch"] = info["branch"]
        return True, f"Provisioned worktree for {repo_name} on '{wt['branch']}' at {wt['worktree_path']}"

    if not force:
        safety = check_worktree_safety(str(cur_wt_path))
        if not safety["clean"]:
            return (
                False,
                f"Worktree for '{repo_name}' has uncommitted changes ({len(safety['dirty_files'])} files); "
                "commit/stash first or pass --force",
            )

    real_cur = os.path.realpath(str(cur_wt_path))
    for gwt in list_git_worktrees(repo_path):
        if gwt.get("branch") == target_branch and gwt.get("path"):
            real_gwt = os.path.realpath(gwt["path"])
            if real_gwt != real_cur:
                if not _detach_worktree_if_clean(real_gwt):
                    return (
                        False,
                        f"Branch '{target_branch}' is already checked out with uncommitted changes in {real_gwt}",
                    )
            break

    _fetch_branch_if_needed(cur_wt_path, repo_path, target_branch)

    if git_ref_exists(repo_path, f"refs/heads/{target_branch}"):
        co_cmd = ["git", "-C", str(cur_wt_path), "checkout", target_branch]
    elif git_ref_exists(repo_path, f"refs/remotes/origin/{target_branch}"):
        co_cmd = ["git", "-C", str(cur_wt_path), "checkout", "--track", "-b", target_branch, f"origin/{target_branch}"]
    else:
        co_cmd = ["git", "-C", str(cur_wt_path), "checkout", "-b", target_branch]

    co_res = subprocess.run(co_cmd, capture_output=True, text=True, check=False)
    if co_res.returncode != 0:
        err_txt = co_res.stderr.strip() or co_res.stdout.strip()
        return False, f"git checkout '{target_branch}' failed in {repo_name}: {err_txt}"

    wt["branch"] = target_branch
    return True, f"Switched {repo_name} worktree to branch '{wt['branch']}' ({wt['worktree_path']})"


def ensure_git_worktree(
    repo: str,
    branch: str,
    cfg: dict[str, Any],
    task_id: str | None = None,
    used_wt_paths: set[str] | None = None,
) -> dict[str, str]:
    """
    Task-scoped git worktree provisioning at `<worktrees_root>/<task_id>/<repo>`.
    """
    branch = validate_git_branch(branch)
    repo_name, repo_path = resolve_repo_path(repo, cfg)
    wt_root = Path(os.path.expanduser(cfg.get("worktrees_root", DEFAULT_CONFIG["worktrees_root"])))
    scope_folder = slugify(task_id, max_len=48) if task_id else slugify(branch, max_len=64)
    target_wt_path = (wt_root / scope_folder / repo_name).resolve()
    used_real = {os.path.realpath(p) for p in (used_wt_paths or set()) if p}

    if os.path.realpath(str(target_wt_path)) in used_real:
        target_wt_path = (wt_root / scope_folder / f"{repo_name}-{slugify(branch, max_len=24)}").resolve()

    # 1. If target_wt_path already exists as a valid git worktree, reuse it
    if target_wt_path.exists() and (target_wt_path / ".git").exists():
        wt_obj = {
            "repo": repo_name,
            "repo_path": str(repo_path),
            "worktree_path": str(target_wt_path),
            "branch": branch,
        }
        res = subprocess.run(
            ["git", "-C", str(target_wt_path), "rev-parse", "--abbrev-ref", "HEAD"],
            capture_output=True,
            text=True,
            check=False,
        )
        cur_b = res.stdout.strip() if res.returncode == 0 else ""
        if cur_b and cur_b != branch and check_worktree_safety(str(target_wt_path))["clean"]:
            ok, _ = switch_worktree_branch(wt_obj, branch, cfg, task_id=task_id)
            if not ok:
                wt_obj["branch"] = cur_b
        else:
            wt_obj["branch"] = cur_b or branch
        return wt_obj

    subprocess.run(["git", "-C", str(repo_path), "worktree", "prune"], capture_output=True, check=False)

    # 2. If branch is currently checked out in another worktree, handle collision cleanly
    real_repo_path = os.path.realpath(str(repo_path))
    for wt in list_git_worktrees(repo_path):
        wt_p = wt.get("path", "")
        wt_b = wt.get("branch", "")
        if wt_b == branch and wt_p:
            real_wt_p = os.path.realpath(wt_p)
            if real_wt_p == real_repo_path:
                if not _detach_worktree_if_clean(str(repo_path)):
                    raise RuntimeError(
                        f"Branch '{branch}' is checked out with uncommitted changes in main repo {repo_path}"
                    )
            elif real_wt_p not in used_real:
                # Adopt existing linked worktree if it already has this branch checked out
                return {
                    "repo": repo_name,
                    "repo_path": str(repo_path),
                    "worktree_path": wt_p,
                    "branch": branch,
                }
            else:
                raise RuntimeError(
                    f"Branch '{branch}' is already checked out in another task worktree ({wt_p})"
                )
            break

    target_wt_path.parent.mkdir(parents=True, exist_ok=True)

    # 3. Checkout local branch, tracking remote branch, or create new branch from default base
    if git_ref_exists(repo_path, f"refs/heads/{branch}"):
        cmd = ["git", "-C", str(repo_path), "worktree", "add", str(target_wt_path), branch]
    else:
        _fetch_branch_if_needed(repo_path, repo_path, branch)
        if git_ref_exists(repo_path, f"refs/remotes/origin/{branch}"):
            cmd = [
                "git", "-C", str(repo_path), "worktree", "add",
                "--track", "-b", branch, str(target_wt_path), f"origin/{branch}",
            ]
        else:
            base_ref = detect_default_base_ref(repo_path)
            cmd = ["git", "-C", str(repo_path), "worktree", "add", "-b", branch, str(target_wt_path), base_ref]

    res = subprocess.run(cmd, capture_output=True, text=True, check=False)
    if res.returncode != 0:
        raise RuntimeError(f"git worktree add failed for {repo_name}: {res.stderr.strip() or res.stdout.strip()}")

    return {
        "repo": repo_name,
        "repo_path": str(repo_path),
        "worktree_path": str(target_wt_path),
        "branch": branch,
    }


# ---------------------------------------------------------------------------
# Herdr CLI / Socket Wrapper
# ---------------------------------------------------------------------------

class HerdrClient:
    def __init__(self, cfg: dict[str, Any]) -> None:
        self.herdr_bin = resolve_bin("herdr", cfg, "herdr_bin")
        self.session = os.environ.get("HERDR_SESSION") or cfg.get("herdr_session")
        if not self.session:
            default_sock = Path(os.path.expanduser("~/.config/herdr/herdr.sock"))
            sessions_dir = Path(os.path.expanduser("~/.config/herdr/sessions"))
            if not default_sock.exists() and sessions_dir.is_dir():
                for s_dir in sessions_dir.iterdir():
                    if s_dir.is_dir() and (s_dir / "herdr.sock").exists():
                        self.session = s_dir.name
                        break

    def run(self, args: list[str], timeout: float = 15.0) -> tuple[int, dict[str, Any] | None, str]:
        cmd = [self.herdr_bin]
        if self.session and "--session" not in args:
            cmd.extend(["--session", self.session])
        cmd.extend(args)
        env = dict(os.environ)
        if self.session:
            env["HERDR_SESSION"] = self.session
            s_sock = os.path.expanduser(f"~/.config/herdr/sessions/{self.session}/herdr.sock")
            if os.path.exists(s_sock):
                env["HERDR_SOCKET"] = s_sock
        try:
            res = subprocess.run(
                cmd,
                capture_output=True,
                text=True,
                timeout=timeout,
                check=False,
                env=env,
            )
        except Exception as e:
            return 1, None, str(e)

        out = res.stdout.strip()
        err = res.stderr.strip()
        parsed: dict[str, Any] | None = None
        for stream in (out, err):
            if stream and parsed is None:
                try:
                    cand = json.loads(stream)
                    if isinstance(cand, dict):
                        parsed = cand
                except Exception:
                    pass
        return res.returncode, parsed, err or out

    def list_workspaces(self) -> list[dict[str, Any]]:
        rc, data, _ = self.run(["workspace", "list"])
        if rc == 0 and isinstance(data, dict):
            return (data.get("result") or {}).get("workspaces") or []
        return []

    def list_tabs(self, workspace_id: str) -> list[dict[str, Any]]:
        rc, data, _ = self.run(["tab", "list", "--workspace", workspace_id])
        if rc == 0 and isinstance(data, dict):
            return (data.get("result") or {}).get("tabs") or []
        return []

    def create_workspace(self, cwd: str, label: str, task_id: str, focus: bool = False) -> dict[str, Any] | None:
        cmd = [
            "workspace", "create",
            "--cwd", cwd,
            "--label", label,
            "--env", f"HERDR_TASK_ID={task_id}",
            "--focus" if focus else "--no-focus",
        ]
        rc, data, _ = self.run(cmd)
        if rc == 0 and isinstance(data, dict):
            return data.get("result") or {}
        return None

    def create_tab(self, workspace_id: str, cwd: str, label: str, task_id: str, focus: bool = False) -> dict[str, Any] | None:
        cmd = [
            "tab", "create",
            "--workspace", workspace_id,
            "--cwd", cwd,
            "--label", label,
            "--env", f"HERDR_TASK_ID={task_id}",
            "--focus" if focus else "--no-focus",
        ]
        rc, data, _ = self.run(cmd)
        if rc == 0 and isinstance(data, dict):
            return data.get("result") or {}
        return None

    def rename_tab(self, tab_id: str, label: str) -> bool:
        rc, _, _ = self.run(["tab", "rename", tab_id, label])
        return rc == 0

    def close_workspace(self, workspace_id: str, group: bool = False) -> bool:
        cmd = ["workspace", "close", workspace_id]
        if group:
            cmd.append("--group")
        rc, _, _ = self.run(cmd)
        return rc == 0

    def open_worktree_workspace(
        self,
        repo_path: str | None = None,
        workspace_id: str | None = None,
        worktree_path: str | None = None,
        branch: str | None = None,
        label: str | None = None,
        focus: bool = False,
        trust_repository: bool = True,
    ) -> dict[str, Any] | None:
        cmd = ["worktree", "open"]
        if repo_path:
            cmd.extend(["--cwd", repo_path])
        elif workspace_id:
            cmd.extend(["--workspace", workspace_id])
        if worktree_path:
            cmd.extend(["--path", worktree_path])
        elif branch:
            cmd.extend(["--branch", branch])
        if label:
            cmd.extend(["--label", label])
        if focus:
            cmd.append("--focus")
        else:
            cmd.append("--no-focus")
        if trust_repository:
            cmd.append("--trust-repository")
        rc, data, _ = self.run(cmd)
        if rc == 0 and isinstance(data, dict):
            return data.get("result") or {}
        return None

    def list_worktrees(self, workspace_id: str | None = None) -> list[dict[str, Any]]:
        cmd = ["worktree", "list"]
        if workspace_id:
            cmd.extend(["--workspace", workspace_id])
        rc, data, _ = self.run(cmd)
        if rc == 0 and isinstance(data, dict):
            return (data.get("result") or {}).get("worktrees") or []
        return []

    def rename_workspace(self, workspace_id: str, label: str) -> bool:
        rc, _, _ = self.run(["workspace", "rename", workspace_id, label])
        return rc == 0

    def focus_workspace(self, workspace_id: str) -> bool:
        rc, _, _ = self.run(["workspace", "focus", workspace_id])
        return rc == 0

    def focus_tab(self, tab_id: str) -> bool:
        rc, _, _ = self.run(["tab", "focus", tab_id])
        return rc == 0

    def split_pane(self, target_pane_id: str, direction: str, cwd: str, no_focus: bool = True) -> str | None:
        cmd = ["pane", "split", target_pane_id, "--direction", direction, "--cwd", cwd]
        if no_focus:
            cmd.append("--no-focus")
        rc, data, _ = self.run(cmd)
        if rc == 0 and isinstance(data, dict):
            return ((data.get("result") or {}).get("pane") or {}).get("pane_id")
        return None

    def rename_pane(self, pane_id: str, label: str) -> bool:
        rc, _, _ = self.run(["pane", "rename", pane_id, label])
        return rc == 0

    def run_in_pane(self, pane_id: str, command: str) -> bool:
        rc, _, _ = self.run(["pane", "run", pane_id, command])
        return rc == 0

    def provision_repo_cockpit(
        self,
        root_pane_id: str,
        cwd: str,
        agent_cmd: str | None = None,
        editor_cmd: str | None = None,
        git_cmd: str | None = None,
    ) -> dict[str, str]:
        p_editor = root_pane_id
        self.rename_pane(p_editor, "code")

        p_agent = self.split_pane(p_editor, direction="right", cwd=cwd, no_focus=True)
        if p_agent:
            self.rename_pane(p_agent, "agent")

        p_term = self.split_pane(p_editor, direction="down", cwd=cwd, no_focus=True)
        if p_term:
            self.rename_pane(p_term, "term")

        p_git = None
        if p_agent:
            p_git = self.split_pane(p_agent, direction="down", cwd=cwd, no_focus=True)
            if p_git:
                self.rename_pane(p_git, "git")

        time.sleep(0.25)

        e_cmd = (editor_cmd or os.environ.get("EDITOR") or "nvim .").strip()
        e_bin = extract_cmd_binary(e_cmd)
        if e_bin and (shutil.which(e_bin) or os.path.exists(e_bin)):
            self.run_in_pane(p_editor, e_cmd)
        elif shutil.which("vim"):
            self.run_in_pane(p_editor, "vim .")

        g_cmd = (git_cmd or "lazygit").strip()
        g_bin = extract_cmd_binary(g_cmd)
        if p_git and g_bin and (shutil.which(g_bin) or os.path.exists(g_bin)):
            self.run_in_pane(p_git, g_cmd)

        if p_agent and agent_cmd and agent_cmd.strip():
            self.run_in_pane(p_agent, agent_cmd.strip())

        return {
            "editor": p_editor,
            "agent": p_agent or "",
            "term": p_term or "",
            "git": p_git or "",
        }

    def sync_sidebar_metadata(self, task: dict[str, Any]) -> bool:
        ws_id = task.get("workspace_id")
        if not ws_id:
            return False

        tickets = [
            r.get("ref") or r.get("label")
            for r in task.get("resources", [])
            if r.get("category") == "ticket" and (r.get("ref") or r.get("label"))
        ]
        ticket_str = ", ".join(tickets[:2])

        cmd = ["workspace", "report-metadata", ws_id, "--source", "task-pilot"]
        if ticket_str:
            cmd.extend(["--token", f"tickets={ticket_str}"])
        else:
            cmd.extend(["--clear-token", "tickets"])

        for i in range(1, 5):
            cmd.extend(["--clear-token", f"proj{i}"])

        rc, _, _ = self.run(cmd)
        return rc == 0


# ---------------------------------------------------------------------------
# Workspace & Tab Provisioning
# ---------------------------------------------------------------------------

def compute_workspace_label(task: dict[str, Any]) -> str:
    task_id = task["id"]
    t_key = next(
        (r.get("ref") for r in task.get("resources", []) if r.get("category") == "ticket" and r.get("ref")),
        None,
    )
    title_text = task.get("title") or task_id
    if t_key and not title_text.startswith(t_key) and f"[{t_key}]" not in title_text:
        return f"[{t_key}] {title_text}"[:28].strip()
    return title_text[:28].strip()


def _provision_tab_cockpit(herdr: HerdrClient, wt: dict[str, Any], root_pane: str | None, cfg: dict[str, Any]) -> None:
    wt["pane_id"] = root_pane
    if cfg.get("cockpit_layout", True) and root_pane:
        wt["cockpit_panes"] = herdr.provision_repo_cockpit(
            root_pane_id=root_pane,
            cwd=wt["worktree_path"],
            agent_cmd=cfg.get("cockpit_agent", "copilot"),
            editor_cmd=cfg.get("cockpit_editor", "nvim ."),
            git_cmd=cfg.get("cockpit_git", "lazygit"),
        )


def provision_herdr_workspace_for_task(
    herdr: HerdrClient,
    task: dict[str, Any],
    focus: bool = False,
    cfg: dict[str, Any] | None = None,
) -> bool:
    cfg = cfg or {}
    task_id = task["id"]
    wts = task.get("worktrees", [])
    ws_label = compute_workspace_label(task)
    # The primary task workspace acts as the Task Hub
    hub_cwd = os.path.expanduser("~")

    ws_res = herdr.create_workspace(hub_cwd, ws_label, task_id, focus=focus)
    if not ws_res:
        return False

    ws_id = (ws_res.get("workspace") or {}).get("workspace_id")
    first_tab_id = (ws_res.get("tab") or {}).get("tab_id")
    if not ws_id:
        return False

    task["workspace_id"] = ws_id
    if first_tab_id:
        herdr.rename_tab(first_tab_id, "hub")

    # Open each repo as a linked worktree workspace nested under its repo parent
    for idx, wt in enumerate(wts):
        wt_label = wt.get("tab_title") or wt["repo"]
        child_res = herdr.open_worktree_workspace(
            repo_path=wt.get("repo_path"),
            workspace_id=ws_id,
            worktree_path=wt["worktree_path"],
            branch=wt.get("branch"),
            label=wt_label,
            focus=(focus and idx == 0),
            trust_repository=True,
        )
        if child_res:
            child_ws_id = (child_res.get("workspace") or {}).get("workspace_id")
            child_tab_id = (child_res.get("tab") or {}).get("tab_id")
            child_pane_id = (
                (child_res.get("root_pane") or {}).get("pane_id")
                or (child_res.get("pane") or {}).get("pane_id")
            )
            wt["workspace_id"] = child_ws_id
            wt["tab_id"] = child_tab_id
            wt["pane_id"] = child_pane_id
            if child_pane_id:
                _provision_tab_cockpit(herdr, wt, child_pane_id, cfg)
        else:
            # Fallback to single-workspace tab if open_worktree_workspace is unsupported or unavailable
            t_res = herdr.create_tab(
                ws_id,
                wt["worktree_path"],
                wt_label,
                task_id,
                focus=(focus and idx == 0),
            )
            if t_res:
                wt["workspace_id"] = None
                wt["tab_id"] = (t_res.get("tab") or {}).get("tab_id")
                _provision_tab_cockpit(herdr, wt, (t_res.get("root_pane") or {}).get("pane_id"), cfg)

    herdr.sync_sidebar_metadata(task)
    return True


# ---------------------------------------------------------------------------
# CLI Command Implementations
# ---------------------------------------------------------------------------

def cmd_create(args: argparse.Namespace, paths: TaskPaths, cfg: dict[str, Any]) -> int:
    spec: dict[str, Any] = {}
    if getattr(args, "spec_stdin", False):
        raw_stdin = sys.stdin.read().strip()
        if raw_stdin:
            spec = json.loads(raw_stdin)

    title = spec.get("title") or getattr(args, "title", None) or "Untitled Task"
    raw_id = spec.get("id") or getattr(args, "id", None)
    brief = spec.get("brief") or getattr(args, "brief", None)
    raw_status = spec.get("status") or getattr(args, "task_status", None)
    explicit_task_status = bool(raw_status)
    initial_task_status = raw_status or "in_progress"
    if initial_task_status not in VALID_TASK_STATUSES:
        initial_task_status = "in_progress"

    raw_resources: list[Any] = list(spec.get("resources") or [])
    for link_val in getattr(args, "link", None) or []:
        raw_resources.append({
            "ref": link_val,
            "label": getattr(args, "label", None),
            "status": getattr(args, "status", None),
            "summary": getattr(args, "summary", None),
        })

    classified_resources: list[dict[str, Any]] = []
    first_ticket_key: str | None = None
    for item in raw_resources:
        if isinstance(item, str):
            res_obj = classify_resource(item, cfg, added_by="pilot")
        elif isinstance(item, dict):
            target_str = (
                item.get("input") or item.get("target") or item.get("url")
                or item.get("ref") or item.get("id") or ""
            )
            if not target_str:
                continue
            res_obj = classify_resource(
                target_str,
                cfg,
                category=item.get("category"),
                provider=item.get("provider"),
                label=item.get("label"),
                status=item.get("status"),
                summary=item.get("summary"),
                added_by=item.get("added_by") or "pilot",
                metadata=item.get("metadata"),
            )
        else:
            continue
        if res_obj["category"] == "ticket" and not first_ticket_key:
            first_ticket_key = res_obj["ref"]
        classified_resources.append(res_obj)

    repo_branch_overrides: dict[str, str] = {}
    inferred_pr_repos: list[str] = []
    for res_obj in list(classified_resources):
        meta = res_obj.get("metadata") or {}
        if meta.get("repo") and meta.get("branch"):
            repo_branch_overrides[meta["repo"]] = meta["branch"]
        if meta.get("repo") and meta["repo"] not in inferred_pr_repos:
            inferred_pr_repos.append(meta["repo"])
        if title == "Untitled Task" and meta.get("pr_title"):
            title = meta["pr_title"]
        jk = meta.get("jira_key")
        if jk and not first_ticket_key:
            first_ticket_key = jk
            if not any(r.get("ref") == jk for r in classified_resources):
                classified_resources.insert(0, classify_resource(jk, cfg, added_by="pilot"))

    if not raw_id:
        rand_suffix = uuid.uuid4().hex[:4]
        if first_ticket_key:
            raw_id = f"{first_ticket_key}-{slugify(title, 24)}-{rand_suffix}"
        else:
            raw_id = f"{slugify(title, 28)}-{rand_suffix}"
    task_id = slugify(raw_id, 48)

    now = now_iso()
    with task_store_lock(paths):
        while paths.task_file(task_id).exists():
            task_id = slugify(f"{task_id[:43]}-{uuid.uuid4().hex[:4]}", 48)
        first_pr_branch = next(iter(repo_branch_overrides.values()), None)
        default_branch = (
            spec.get("branch")
            or spec.get("default_branch")
            or getattr(args, "branch", None)
            or first_pr_branch
            or (f"feat/{task_id}" if first_ticket_key else task_id)
        )
        task: dict[str, Any] = {
            "id": task_id,
            "title": title,
            "brief": brief,
            "status": initial_task_status,
            "created_at": now,
            "updated_at": now,
            "workspace_id": None,
            "default_branch": default_branch,
            "worktrees": [],
            "resources": [],
            "notes": [],
        }
        for res_obj in classified_resources:
            upsert_resource(task, res_obj)
        # Reserve the task ID atomically before provisioning worktrees/workspaces
        atomic_write_json(paths.task_file(task_id), task)

    repos: list[str] = []
    if "repos" in spec and isinstance(spec["repos"], list):
        for r in spec["repos"]:
            if isinstance(r, str) and r.strip() and r.strip() not in repos:
                repos.append(r.strip())
            elif isinstance(r, dict):
                r_target = (r.get("path") or r.get("repo") or r.get("name") or "").strip()
                if r_target:
                    if r_target not in repos:
                        repos.append(r_target)
                    if r.get("branch"):
                        repo_branch_overrides[Path(r_target).name] = r["branch"]
                        repo_branch_overrides[r_target] = r["branch"]
    if getattr(args, "repos", None):
        for r in args.repos.split(","):
            if r.strip() and r.strip() not in repos:
                repos.append(r.strip())
    for r_single in getattr(args, "repo_list", None) or []:
        for r in r_single.split(","):
            if r.strip() and r.strip() not in repos:
                repos.append(r.strip())

    if not repos and inferred_pr_repos:
        for cand_repo in inferred_pr_repos:
            try:
                resolve_repo_path(cand_repo, cfg)
                repos.append(cand_repo)
            except Exception:
                pass

    worktrees: list[dict[str, Any]] = []
    used_wt_paths: set[str] = collect_active_worktree_paths(paths, exclude_task_id=task_id)
    try:
        for r_name in repos:
            r_short_guess = Path(r_name).name
            target_branch = (
                repo_branch_overrides.get(r_name)
                or repo_branch_overrides.get(r_short_guess)
                or default_branch
            )
            wt_info = ensure_git_worktree(
                r_name,
                target_branch,
                cfg,
                task_id=task_id,
                used_wt_paths=used_wt_paths,
            )
            used_wt_paths.add(wt_info["worktree_path"])
            worktrees.append({
                **wt_info,
                "workspace_id": None,
                "tab_id": None,
                "pane_id": None,
            })
    except Exception:
        with task_store_lock(paths):
            tf = paths.task_file(task_id)
            if tf.exists():
                tf.unlink()
        raise

    task["worktrees"] = worktrees
    _, auto_msgs = dispatch_automation_event(
        "task.created",
        task,
        paths,
        cfg,
        explicit_task_status=explicit_task_status,
    )

    if not getattr(args, "no_herdr", False):
        try:
            herdr = HerdrClient(cfg)
            provision_herdr_workspace_for_task(
                herdr,
                task,
                focus=bool(getattr(args, "focus", False)),
                cfg=cfg,
            )
        except Exception as e:
            print(f"Warning: could not provision Herdr workspace for task '{task_id}': {e}", file=sys.stderr)

    with task_store_lock(paths):
        task["updated_at"] = now_iso()
        atomic_write_json(paths.task_file(task_id), task)

    if getattr(args, "json", False):
        print(json.dumps(task, indent=2))
    else:
        print(f"Created task '{task_id}' (workspace: {task.get('workspace_id') or 'none'}, repos: {len(worktrees)}, resources: {len(task['resources'])})")
        for m in auto_msgs:
            print(f"  ↳ {m}")
    return 0


def cmd_current(args: argparse.Namespace, paths: TaskPaths, cfg: dict[str, Any]) -> int:
    tid = resolve_current_task_id(paths)
    if not tid:
        if getattr(args, "json", False):
            print(json.dumps({"task_id": None}))
        else:
            print("No active task resolved for current context.", file=sys.stderr)
        return 1
    if getattr(args, "json", False):
        print(json.dumps({"task_id": tid}))
    else:
        print(tid)
    return 0


def cmd_link(args: argparse.Namespace, paths: TaskPaths, cfg: dict[str, Any]) -> int:
    tid = resolve_current_task_id(paths, getattr(args, "task", None))
    if not tid:
        print("Error: could not resolve active task. Pass --task <id>.", file=sys.stderr)
        return 1

    meta_dict: dict[str, Any] = {}
    for kv in getattr(args, "metadata", None) or []:
        if "=" in kv:
            k, v = kv.split("=", 1)
            meta_dict[k.strip()] = v.strip()

    existing_task = load_task(paths, tid)
    if not existing_task:
        print(f"Error: task '{tid}' not found.", file=sys.stderr)
        return 1

    has_partial_update_flags = any(
        getattr(args, f, None) is not None for f in ("label", "status", "summary")
    )
    fetch_remote = True
    if has_partial_update_flags and not getattr(args, "sync_branch", False):
        m_pr = GH_PR_URL_RE.search(args.target.strip())
        pr_ref = f"{m_pr.group(2)}#{m_pr.group(3)}" if m_pr else args.target.strip()
        for r in existing_task.get("resources", []):
            if (r.get("ref") == pr_ref or r.get("url") == args.target.strip()) and (r.get("metadata") or {}).get("branch"):
                fetch_remote = False
                break

    res_obj = classify_resource(
        args.target,
        cfg,
        category=getattr(args, "category", None),
        provider=getattr(args, "provider", None),
        label=getattr(args, "label", None),
        status=getattr(args, "status", None),
        summary=getattr(args, "summary", None),
        added_by=getattr(args, "added_by", None),
        metadata=meta_dict or None,
        fetch_remote=fetch_remote,
    )

    branch_switch_msg: str | None = None
    title_updated = False
    auto_msgs: list[str] = []
    with task_store_lock(paths):
        task = load_task(paths, tid)
        if not task:
            print(f"Error: task '{tid}' not found.", file=sys.stderr)
            return 1
        old_title = task.get("title")
        saved = upsert_resource(task, res_obj)

        _, auto_msgs = dispatch_automation_event(
            "resource.linked",
            task,
            paths,
            cfg,
            resource=saved,
        )

        meta = saved.get("metadata") or {}
        jk = meta.get("jira_key")
        if jk and not any(r.get("category") == "ticket" and r.get("ref") == jk for r in task.get("resources", [])):
            jk_res = upsert_resource(task, classify_resource(jk, cfg, added_by="pilot"))
            _, jk_msgs = dispatch_automation_event("resource.linked", task, paths, cfg, resource=jk_res)
            auto_msgs.extend(jk_msgs)

        if task.get("title") in (None, "", "Untitled Task") and meta.get("pr_title"):
            task["title"] = meta["pr_title"]
        if task.get("title") != old_title:
            title_updated = True

        pr_repo = meta.get("repo")
        pr_branch = meta.get("branch")
        if pr_repo and pr_branch:
            placeholders = {
                b for b in (task.get("id"), task.get("default_branch"), f"feat/{task.get('id')}") if b
            }
            for wt in task.get("worktrees", []):
                if wt.get("repo") == pr_repo and wt.get("branch") != pr_branch:
                    if getattr(args, "sync_branch", False) or wt.get("branch") in placeholders:
                        ok, msg = switch_worktree_branch(wt, pr_branch, cfg, task_id=tid, force=False)
                        if ok:
                            branch_switch_msg = msg
                    break

        task["updated_at"] = now_iso()
        atomic_write_json(paths.task_file(tid), task)

    if not getattr(args, "no_herdr", False):
        herdr = HerdrClient(cfg)
        if title_updated and task.get("workspace_id"):
            herdr.rename_workspace(task["workspace_id"], compute_workspace_label(task))
        herdr.sync_sidebar_metadata(task)

    if getattr(args, "json", False):
        print(json.dumps(saved, indent=2))
    else:
        print(f"Linked [{saved['category']}] {saved['ref']} -> task '{tid}'")
        if branch_switch_msg:
            print(f"  ↳ {branch_switch_msg}")
        for m in auto_msgs:
            print(f"  ↳ {m}")
    return 0


def cmd_unlink(args: argparse.Namespace, paths: TaskPaths, cfg: dict[str, Any]) -> int:
    tid = resolve_current_task_id(paths, getattr(args, "task", None))
    if not tid:
        print("Error: could not resolve active task. Pass --task <id>.", file=sys.stderr)
        return 1

    target = args.target.strip()
    with task_store_lock(paths):
        task = load_task(paths, tid)
        if not task:
            print(f"Error: task '{tid}' not found.", file=sys.stderr)
            return 1
        before = len(task.get("resources", []))
        task["resources"] = [
            r for r in task.get("resources", [])
            if r.get("id") != target and r.get("ref") != target and r.get("url") != target
        ]
        removed = before - len(task["resources"])
        task["updated_at"] = now_iso()
        atomic_write_json(paths.task_file(tid), task)

    if not getattr(args, "no_herdr", False):
        HerdrClient(cfg).sync_sidebar_metadata(task)

    print(f"Removed {removed} resource(s) from '{tid}'.")
    return 0 if removed > 0 else 1


def cmd_note(args: argparse.Namespace, paths: TaskPaths, cfg: dict[str, Any]) -> int:
    tid = resolve_current_task_id(paths, getattr(args, "task", None))
    if not tid:
        print("Error: could not resolve active task. Pass --task <id>.", file=sys.stderr)
        return 1

    author = getattr(args, "author", None) or os.environ.get("USER") or "agent"
    note_entry = {
        "timestamp": now_iso(),
        "author": author,
        "text": args.text.strip(),
    }

    with task_store_lock(paths):
        task = load_task(paths, tid)
        if not task:
            print(f"Error: task '{tid}' not found.", file=sys.stderr)
            return 1
        task.setdefault("notes", []).append(note_entry)
        task["updated_at"] = now_iso()
        atomic_write_json(paths.task_file(tid), task)

    if getattr(args, "json", False):
        print(json.dumps(note_entry, indent=2))
    else:
        print(f"Added handoff note to '{tid}'.")
    return 0


def format_task_status_text(task: dict[str, Any], color: bool = False) -> str:
    c_bold = "\033[1m" if color else ""
    c_cyan = "\033[36m" if color else ""
    c_green = "\033[32m" if color else ""
    c_yellow = "\033[33m" if color else ""
    c_magenta = "\033[35m" if color else ""
    c_dim = "\033[2m" if color else ""
    c_reset = "\033[0m" if color else ""

    raw_st = (task.get("status") or "in_progress").lower()
    st_icon = TASK_STATUS_ICONS.get(raw_st, "🚧")
    st_color = (
        c_green if raw_st == "done"
        else c_magenta if raw_st == "in_review"
        else c_yellow if raw_st == "todo"
        else c_dim if raw_st == "archived"
        else c_cyan
    )

    lines = [
        f"{c_bold}{st_color}{st_icon} [{raw_st.upper()}] {task['id']}: {task.get('title', '')}{c_reset}  {c_dim}(ws: {task.get('workspace_id') or 'closed'}){c_reset}",
    ]
    if task.get("brief"):
        lines.append(f"{c_bold}Brief:{c_reset} {task['brief']}")

    lines.append("")
    wts = task.get("worktrees", [])
    lines.append(f"{c_bold}Repository Worktrees ({len(wts)}):{c_reset}")
    if not wts:
        lines.append(f"  {c_dim}(No repo worktrees attached){c_reset}")
    for wt in wts:
        tab_str = wt.get("workspace_id") or wt.get("tab_id") or "no-ws"
        lines.append(f"  ↳ [{tab_str}] {c_bold}{wt['repo']}{c_reset} ({c_yellow}{wt.get('branch', '')}{c_reset})")
        lines.append(f"           {c_dim}{wt.get('worktree_path', '')}{c_reset}")

    resources = task.get("resources", [])
    by_cat: dict[str, list[dict[str, Any]]] = {}
    for r in resources:
        by_cat.setdefault(r.get("category", "custom"), []).append(r)

    cat_titles = [
        ("ticket", "Tickets"),
        ("pull_request", "Pull Requests"),
        ("issue", "Issues"),
        ("alert", "Alerts & Monitors"),
        ("conversation", "Conversations"),
        ("doc", "Documentation & Specs"),
        ("custom", "Other Resources"),
    ]
    for cat_key, cat_title in cat_titles:
        items = by_cat.get(cat_key, [])
        if not items:
            continue
        lines.append("")
        lines.append(f"{c_bold}{cat_title} ({len(items)}):{c_reset}")
        for r in items:
            badge = f" [{r['status']}]" if r.get("status") else ""
            lines.append(f"  • {c_bold}{r.get('ref')}{c_reset}{c_yellow}{badge}{c_reset} — {r.get('label', '')}")
            lines.append(f"    {c_dim}{r.get('url', '')}{c_reset}")
            if r.get("summary"):
                lines.append(f"    {c_cyan}Summary:{c_reset} {r['summary']}")

    notes = task.get("notes", [])
    if notes:
        lines.append("")
        lines.append(f"{c_bold}Cross-Repo Handoff Notes ({len(notes)}):{c_reset}")
        for n in notes:
            lines.append(f"  > [{n.get('author', 'note')}] {n.get('text', '')}")

    return "\n".join(lines)


def cmd_status(args: argparse.Namespace, paths: TaskPaths, cfg: dict[str, Any]) -> int:
    tid = resolve_current_task_id(paths, getattr(args, "task_id", None), include_archived=True)
    if not tid:
        print("Error: could not resolve task. Pass <task-id>.", file=sys.stderr)
        return 1
    task = load_task(paths, tid, include_archived=True)
    if not task:
        print(f"Error: task '{tid}' not found.", file=sys.stderr)
        return 1

    if getattr(args, "json", False):
        print(json.dumps(task, indent=2))
    else:
        print(format_task_status_text(task, color=bool(getattr(args, "color", False))))
    return 0


def format_fzf_task_line(t: dict[str, Any]) -> str:
    repos_seen: list[str] = []
    for w in t.get("worktrees", []):
        if w["repo"] not in repos_seen:
            repos_seen.append(w["repo"])
    repos = ",".join(repos_seen) or "no-repo"
    tickets = ",".join(
        r["ref"] for r in t.get("resources", []) if r.get("category") == "ticket"
    ) or "-"
    ws = t.get("workspace_id") or "-"
    st = (t.get("status") or "in_progress").lower()
    st_icon = TASK_STATUS_ICONS.get(st, "🚧")
    branches = " ".join(w.get("branch", "") for w in t.get("worktrees", []))
    res_tokens = " ".join(
        f"{r.get('ref', '')} {r.get('label', '')} {r.get('provider', '')} {r.get('status', '')}"
        for r in t.get("resources", [])
    )
    search_blob = f"{st} {branches} {res_tokens}".replace("\t", " ").replace("\n", " ")
    return f"{t['id']}\t{st_icon} [{st.upper()}] [{ws}] {t.get('title', '')}  (repos: {repos} | tickets: {tickets})\t{search_blob}"


def cmd_list(args: argparse.Namespace, paths: TaskPaths, cfg: dict[str, Any]) -> int:
    tasks = list_all_tasks(paths, include_archived=bool(getattr(args, "all", False)))
    if getattr(args, "json", False):
        print(json.dumps(tasks, indent=2))
        return 0
    if getattr(args, "fzf", False):
        for t in tasks:
            print(format_fzf_task_line(t))
        return 0

    if not tasks:
        print("No tasks found.")
        return 0
    for t in tasks:
        repos = ", ".join(w["repo"] for w in t.get("worktrees", [])) or "none"
        res_cnt = len(t.get("resources", []))
        st = (t.get("status") or "in_progress").upper()
        print(f"{t['id']:32} | {st:11} | ws: {str(t.get('workspace_id') or '-'):5} | repos: {repos:24} | resources: {res_cnt} | {t.get('title', '')}")
    return 0


def cmd_focus(args: argparse.Namespace, paths: TaskPaths, cfg: dict[str, Any]) -> int:
    tid = resolve_current_task_id(paths, getattr(args, "task_id", None))
    if not tid:
        print("Error: could not resolve task.", file=sys.stderr)
        return 1

    task = load_task(paths, tid)
    if not task:
        print(f"Error: task '{tid}' not found.", file=sys.stderr)
        return 1

    herdr = HerdrClient(cfg)
    live_ws_ids = {w.get("workspace_id") for w in herdr.list_workspaces()}
    ws_id = task.get("workspace_id")

    if not ws_id or ws_id not in live_ws_ids:
        provision_herdr_workspace_for_task(herdr, task, focus=True, cfg=cfg)
        with task_store_lock(paths):
            fresh = load_task(paths, tid) or task
            fresh["workspace_id"] = task.get("workspace_id")
            fresh["worktrees"] = task.get("worktrees", [])
            fresh["updated_at"] = now_iso()
            atomic_write_json(paths.task_file(tid), fresh)
            task = fresh
    else:
        live_tab_ids = {t.get("tab_id") for t in herdr.list_tabs(ws_id)}
        updated = False
        for wt in task.get("worktrees", []):
            wt_ws = wt.get("workspace_id")
            if (not wt_ws or wt_ws not in live_ws_ids) and Path(wt["worktree_path"]).exists():
                wt_label = wt.get("tab_title") or wt["repo"]
                child_res = herdr.open_worktree_workspace(
                    repo_path=wt.get("repo_path"),
                    workspace_id=ws_id,
                    worktree_path=wt["worktree_path"],
                    branch=wt.get("branch"),
                    label=wt_label,
                    focus=False,
                    trust_repository=True,
                )
                if child_res:
                    wt["workspace_id"] = (child_res.get("workspace") or {}).get("workspace_id")
                    wt["tab_id"] = (child_res.get("tab") or {}).get("tab_id")
                    wt["pane_id"] = (
                        (child_res.get("root_pane") or {}).get("pane_id")
                        or (child_res.get("pane") or {}).get("pane_id")
                    )
                    if wt["pane_id"]:
                        _provision_tab_cockpit(herdr, wt, wt["pane_id"], cfg)
                    updated = True
                elif not wt.get("tab_id") or wt["tab_id"] not in live_tab_ids:
                    t_res = herdr.create_tab(ws_id, wt["worktree_path"], wt_label, tid, focus=False)
                    if t_res:
                        wt["tab_id"] = (t_res.get("tab") or {}).get("tab_id")
                        _provision_tab_cockpit(herdr, wt, (t_res.get("root_pane") or {}).get("pane_id"), cfg)
                        updated = True
        if updated:
            with task_store_lock(paths):
                fresh = load_task(paths, tid) or task
                fresh["worktrees"] = task.get("worktrees", [])
                fresh["updated_at"] = now_iso()
                atomic_write_json(paths.task_file(tid), fresh)
                task = fresh

        target_repo = getattr(args, "repo", None)
        if target_repo:
            focused = False
            for wt in task.get("worktrees", []):
                if wt["repo"] == target_repo:
                    if wt.get("workspace_id") and wt["workspace_id"] in live_ws_ids:
                        herdr.focus_workspace(wt["workspace_id"])
                        focused = True
                        break
                    elif wt.get("tab_id"):
                        herdr.focus_tab(wt["tab_id"])
                        focused = True
                        break
            if not focused:
                herdr.focus_workspace(ws_id)
        else:
            herdr.focus_workspace(ws_id)
        herdr.sync_sidebar_metadata(task)

    return 0


def cmd_worktree_add(args: argparse.Namespace, paths: TaskPaths, cfg: dict[str, Any]) -> int:
    tid = resolve_current_task_id(paths, getattr(args, "task", None))
    if not tid:
        print("Error: could not resolve active task. Pass --task <id>.", file=sys.stderr)
        return 1

    with task_store_lock(paths):
        task = load_task(paths, tid)
        if not task:
            print(f"Error: task '{tid}' not found.", file=sys.stderr)
            return 1

        explicit_branch = getattr(args, "branch", None)
        branch = explicit_branch or task.get("default_branch") or f"feat/{tid}"
        repo_short, _ = resolve_repo_path(args.repo, cfg)

        # If this exact repo + branch is already attached to the task, reuse it instead of duplicating
        existing_same = next(
            (
                w for w in task.get("worktrees", [])
                if w.get("repo") == repo_short and (not explicit_branch or w.get("branch") == branch)
            ),
            None,
        )
        if existing_same and Path(existing_same.get("worktree_path", "")).exists():
            ws_id = task.get("workspace_id")
        else:
            existing_same = None
            used_wt_paths = collect_active_worktree_paths(paths, exclude_task_id=tid) | {
                w["worktree_path"] for w in task.get("worktrees", []) if w.get("worktree_path")
            }
            wt_info = ensure_git_worktree(args.repo, branch, cfg, task_id=tid, used_wt_paths=used_wt_paths)
            repo_short = wt_info["repo"]

            existing_tabs_for_repo = [w for w in task.get("worktrees", []) if w["repo"] == repo_short]
            tab_index = len(existing_tabs_for_repo) + 1
            tab_title = getattr(args, "label", None) or (repo_short if tab_index == 1 else f"{repo_short} #{tab_index}")

            new_wt: dict[str, Any] = {
                **wt_info,
                "tab_title": tab_title,
                "workspace_id": None,
                "tab_id": None,
                "pane_id": None,
            }
            task.setdefault("worktrees", []).append(new_wt)
            task["updated_at"] = now_iso()
            atomic_write_json(paths.task_file(tid), task)
            ws_id = task.get("workspace_id")

    if existing_same is not None:
        if not getattr(args, "no_herdr", False) and ws_id:
            herdr = HerdrClient(cfg)
            live_ws_ids = {w.get("workspace_id") for w in herdr.list_workspaces()}
            live_tab_ids = {t.get("tab_id") for t in herdr.list_tabs(ws_id)}
            existing_ws = existing_same.get("workspace_id")
            if not existing_ws or existing_ws not in live_ws_ids:
                child_res = herdr.open_worktree_workspace(
                    repo_path=existing_same.get("repo_path"),
                    workspace_id=ws_id,
                    worktree_path=existing_same["worktree_path"],
                    branch=existing_same.get("branch"),
                    label=existing_same.get("tab_title") or repo_short,
                    focus=bool(getattr(args, "focus", False)),
                    trust_repository=True,
                )
                if child_res:
                    existing_same["workspace_id"] = (child_res.get("workspace") or {}).get("workspace_id")
                    existing_same["tab_id"] = (child_res.get("tab") or {}).get("tab_id")
                    existing_same["pane_id"] = (
                        (child_res.get("root_pane") or {}).get("pane_id")
                        or (child_res.get("pane") or {}).get("pane_id")
                    )
                    if existing_same["pane_id"]:
                        _provision_tab_cockpit(herdr, existing_same, existing_same["pane_id"], cfg)
                elif not existing_same.get("tab_id") or existing_same["tab_id"] not in live_tab_ids:
                    t_res = herdr.create_tab(
                        ws_id,
                        existing_same["worktree_path"],
                        existing_same.get("tab_title") or repo_short,
                        tid,
                        focus=bool(getattr(args, "focus", False)),
                    )
                    if t_res:
                        existing_same["tab_id"] = (t_res.get("tab") or {}).get("tab_id")
                        _provision_tab_cockpit(herdr, existing_same, (t_res.get("root_pane") or {}).get("pane_id"), cfg)

                with task_store_lock(paths):
                    fresh = load_task(paths, tid)
                    if fresh:
                        for w in fresh.get("worktrees", []):
                            if w.get("worktree_path") == existing_same["worktree_path"]:
                                w["workspace_id"] = existing_same.get("workspace_id")
                                w["tab_id"] = existing_same.get("tab_id")
                                w["pane_id"] = existing_same.get("pane_id")
                                if "cockpit_panes" in existing_same:
                                    w["cockpit_panes"] = existing_same["cockpit_panes"]
                        fresh["updated_at"] = now_iso()
                        atomic_write_json(paths.task_file(tid), fresh)
            elif getattr(args, "focus", False):
                if existing_ws and existing_ws in live_ws_ids:
                    herdr.focus_workspace(existing_ws)
                elif existing_same.get("tab_id"):
                    herdr.focus_tab(existing_same["tab_id"])
        if getattr(args, "json", False):
            print(json.dumps(existing_same, indent=2))
        else:
            print(f"Worktree '{repo_short}' ({existing_same['worktree_path']}) is already attached to task '{tid}'.")
        return 0

    if not getattr(args, "no_herdr", False) and ws_id:
        herdr = HerdrClient(cfg)
        child_res = herdr.open_worktree_workspace(
            repo_path=new_wt.get("repo_path"),
            workspace_id=ws_id,
            worktree_path=new_wt["worktree_path"],
            branch=new_wt.get("branch"),
            label=tab_title,
            focus=bool(getattr(args, "focus", False)),
            trust_repository=True,
        )
        if child_res:
            new_wt["workspace_id"] = (child_res.get("workspace") or {}).get("workspace_id")
            new_wt["tab_id"] = (child_res.get("tab") or {}).get("tab_id")
            new_wt["pane_id"] = (
                (child_res.get("root_pane") or {}).get("pane_id")
                or (child_res.get("pane") or {}).get("pane_id")
            )
            if new_wt["pane_id"]:
                _provision_tab_cockpit(herdr, new_wt, new_wt["pane_id"], cfg)
        else:
            t_res = herdr.create_tab(
                ws_id,
                new_wt["worktree_path"],
                tab_title,
                tid,
                focus=bool(getattr(args, "focus", False)),
            )
            if t_res:
                new_wt["tab_id"] = (t_res.get("tab") or {}).get("tab_id")
                _provision_tab_cockpit(herdr, new_wt, (t_res.get("root_pane") or {}).get("pane_id"), cfg)

        with task_store_lock(paths):
            fresh = load_task(paths, tid)
            if fresh:
                for w in fresh.get("worktrees", []):
                    if w.get("worktree_path") == new_wt["worktree_path"]:
                        w["workspace_id"] = new_wt.get("workspace_id")
                        w["tab_id"] = new_wt.get("tab_id")
                        w["pane_id"] = new_wt.get("pane_id")
                        if "cockpit_panes" in new_wt:
                            w["cockpit_panes"] = new_wt["cockpit_panes"]
                fresh["updated_at"] = now_iso()
                atomic_write_json(paths.task_file(tid), fresh)
                task = fresh

    if not getattr(args, "no_herdr", False):
        HerdrClient(cfg).sync_sidebar_metadata(task)

    if getattr(args, "json", False):
        print(json.dumps(new_wt, indent=2))
    else:
        print(f"Added worktree '{repo_short}' ({new_wt['worktree_path']}) to task '{tid}'.")
    return 0


def cmd_worktree_branch(args: argparse.Namespace, paths: TaskPaths, cfg: dict[str, Any]) -> int:
    tid = resolve_current_task_id(paths, getattr(args, "task", None))
    if not tid:
        print("Error: could not resolve active task. Pass --task <id>.", file=sys.stderr)
        return 1

    target_repo = Path(args.repo).name
    target_branch = args.branch.strip()
    force = bool(getattr(args, "force", False))

    with task_store_lock(paths):
        task = load_task(paths, tid)
        if not task:
            print(f"Error: task '{tid}' not found.", file=sys.stderr)
            return 1

        target_wt = next(
            (w for w in task.get("worktrees", []) if w["repo"] == target_repo or w["repo"] == args.repo),
            None,
        )
        if not target_wt:
            print(f"Error: repo '{args.repo}' is not attached to task '{tid}'.", file=sys.stderr)
            return 1

        ok, msg = switch_worktree_branch(target_wt, target_branch, cfg, task_id=tid, force=force)
        if not ok:
            print(f"Error: {msg}", file=sys.stderr)
            return 1

        task["updated_at"] = now_iso()
        atomic_write_json(paths.task_file(tid), task)

    if getattr(args, "json", False):
        print(json.dumps(target_wt, indent=2))
    else:
        print(msg)
    return 0


def cmd_update(args: argparse.Namespace, paths: TaskPaths, cfg: dict[str, Any]) -> int:
    tid = resolve_current_task_id(paths, getattr(args, "task_id", None) or getattr(args, "task", None))
    if not tid:
        print("Error: could not resolve task to update. Pass <task-id> or --task <id>.", file=sys.stderr)
        return 1

    messages: list[str] = []
    title_changed = False
    force = bool(getattr(args, "force", False))

    with task_store_lock(paths):
        task = load_task(paths, tid)
        if not task:
            print(f"Error: task '{tid}' not found.", file=sys.stderr)
            return 1

        new_title = getattr(args, "title", None)
        if new_title is not None and new_title.strip():
            task["title"] = new_title.strip()
            title_changed = True
            messages.append(f"Updated title -> '{task['title']}'")

        new_brief = getattr(args, "brief", None)
        if new_brief is not None:
            task["brief"] = None if new_brief.strip() == "-" else new_brief.strip()
            messages.append("Updated task brief")

        new_status = getattr(args, "status", None)
        if new_status is not None and new_status.strip():
            norm_st = new_status.strip().lower().replace("-", "_").replace(" ", "_")
            if norm_st not in VALID_TASK_STATUSES:
                print(
                    f"Error: invalid status '{new_status}'. Choose from: {', '.join(VALID_TASK_STATUSES)}",
                    file=sys.stderr,
                )
                return 1
            old_status = task.get("status") or "in_progress"
            if norm_st != old_status:
                task["status"] = norm_st
                if norm_st == "archived":
                    task["archived_at"] = now_iso()
                messages.append(f"Updated task status: '{old_status}' -> '{norm_st}'")
                _, auto_msgs = dispatch_automation_event(
                    "task.status_changed",
                    task,
                    paths,
                    cfg,
                    previous_status=old_status,
                    new_status=norm_st,
                )
                messages.extend(auto_msgs)

        new_def_branch = getattr(args, "branch", None)
        if new_def_branch is not None and new_def_branch.strip():
            task["default_branch"] = new_def_branch.strip()
            messages.append(f"Updated default_branch -> '{task['default_branch']}'")

        repo_branch_map: dict[str, str] = {}
        if getattr(args, "sync_pr_branches", False):
            for r in task.get("resources", []):
                if r.get("category") == "pull_request":
                    meta = r.get("metadata") or {}
                    if not meta.get("branch") and r.get("url"):
                        m = GH_PR_URL_RE.search(r["url"])
                        if m:
                            gh_meta = fetch_github_pr_metadata(m.group(1), m.group(2), m.group(3))
                            if gh_meta.get("branch"):
                                meta["branch"] = gh_meta["branch"]
                                meta["repo"] = m.group(2)
                                r["metadata"] = meta
                    if meta.get("repo") and meta.get("branch"):
                        repo_branch_map[meta["repo"]] = meta["branch"]

        for rb in getattr(args, "repo_branch", None) or []:
            sep = ":" if ":" in rb else ("=" if "=" in rb else None)
            if sep:
                rk, bval = rb.split(sep, 1)
                if rk.strip() and bval.strip():
                    repo_branch_map[Path(rk.strip()).name] = bval.strip()

        if new_def_branch and not repo_branch_map and len(task.get("worktrees", [])) == 1:
            only_repo = task["worktrees"][0]["repo"]
            repo_branch_map[only_repo] = new_def_branch.strip()

        branch_errors = False
        for repo_key, target_b in repo_branch_map.items():
            target_wt = next((w for w in task.get("worktrees", []) if w["repo"] == repo_key), None)
            if target_wt:
                ok, msg = switch_worktree_branch(target_wt, target_b, cfg, task_id=tid, force=force)
                if ok:
                    messages.append(msg)
                else:
                    branch_errors = True
                    messages.append(f"Error: {msg}")
            else:
                branch_errors = True
                messages.append(f"Warning: repo '{repo_key}' is not attached to task '{tid}'")

        task["updated_at"] = now_iso()
        if task.get("status") == "archived":
            atomic_write_json(paths.archive_file(tid), task)
            active_f = paths.task_file(tid)
            if active_f.exists():
                active_f.unlink()
        else:
            atomic_write_json(paths.task_file(tid), task)

    if not getattr(args, "no_herdr", False) and task.get("workspace_id"):
        herdr = HerdrClient(cfg)
        if title_changed:
            herdr.rename_workspace(task["workspace_id"], compute_workspace_label(task))
        herdr.sync_sidebar_metadata(task)

    if getattr(args, "json", False):
        print(json.dumps(task, indent=2))
    else:
        for m in messages or [f"Task '{tid}' is up to date."]:
            stream = sys.stderr if m.startswith("Error:") else sys.stdout
            print(f"• {m}", file=stream)
    return 1 if branch_errors else 0


def cmd_sync(args: argparse.Namespace, paths: TaskPaths, cfg: dict[str, Any]) -> int:
    tid = resolve_current_task_id(paths, getattr(args, "task_id", None) or getattr(args, "task", None))
    if not tid:
        print("Error: could not resolve task to sync. Pass <task-id>.", file=sys.stderr)
        return 1

    messages: list[str] = []
    with task_store_lock(paths):
        task = load_task(paths, tid)
        if not task:
            print(f"Error: task '{tid}' not found.", file=sys.stderr)
            return 1

        modified = False
        # 1. Refresh GitHub PR metadata
        for r in task.get("resources", []):
            if r.get("category") != "pull_request":
                continue
            meta = r.setdefault("metadata", {})
            org: str | None = None
            repo: str | None = None
            num: str | None = None
            m = GH_PR_URL_RE.search(r.get("url") or "")
            if m:
                org, repo, num = m.group(1), m.group(2), m.group(3)
            else:
                m_sh = GH_SHORT_RE.match(r.get("ref") or "")
                if m_sh:
                    repo = m_sh.group(2)
                    num = m_sh.group(3)
                    org = m_sh.group(1) or meta.get("org") or _infer_github_org_for_repo(repo, cfg)
            if org and repo and num:
                gh_meta = fetch_github_pr_metadata(org, repo, num)
                if gh_meta:
                    res_mod = False
                    if not r.get("url") or not r["url"].startswith("http"):
                        r["url"] = f"https://github.com/{org}/{repo}/pull/{num}"
                        res_mod = True
                    if gh_meta.get("status") and r.get("status") != gh_meta["status"]:
                        r["status"] = gh_meta["status"]
                        res_mod = True
                    if gh_meta.get("branch") and meta.get("branch") != gh_meta["branch"]:
                        meta["branch"] = gh_meta["branch"]
                        res_mod = True
                    if gh_meta.get("title") and meta.get("pr_title") != gh_meta["title"]:
                        meta["pr_title"] = gh_meta["title"]
                        res_mod = True
                    if gh_meta.get("title") and (not r.get("label") or r.get("label") in (f"{repo}#{num}", f"{repo} #{num}")):
                        r["label"] = f"{repo}#{num}: {gh_meta['title']}"
                        res_mod = True
                    if gh_meta.get("summary") and not r.get("summary"):
                        r["summary"] = gh_meta["summary"]
                        res_mod = True
                    if res_mod:
                        r["updated_at"] = now_iso()
                        modified = True
                    messages.append(f"[github] Synced {r.get('ref')} -> [{r.get('status') or 'OPEN'}]")

        # 2. Dispatch `task.sync` to all modular automations (e.g. jira_status_sync)
        auto_mod, auto_msgs = dispatch_automation_event("task.sync", task, paths, cfg)
        if auto_mod:
            modified = True
        messages.extend(auto_msgs)

        if modified:
            task["updated_at"] = now_iso()
            atomic_write_json(paths.task_file(tid), task)

    if not getattr(args, "no_herdr", False) and task.get("workspace_id"):
        HerdrClient(cfg).sync_sidebar_metadata(task)

    if getattr(args, "json", False):
        print(json.dumps({"task": task, "messages": messages}, indent=2))
    else:
        for m in messages or [f"Task '{tid}' is up to date."]:
            print(f"• {m}")
    return 0


def cmd_automations(args: argparse.Namespace, paths: TaskPaths, cfg: dict[str, Any]) -> int:
    autos = discover_automations(paths, cfg)
    out_list = [
        {
            "id": a["id"],
            "enabled": a["enabled"],
            "description": a["description"],
            "events": a["events"],
            "path": a["path"],
        }
        for a in autos
    ]
    if getattr(args, "json", False):
        print(json.dumps(out_list, indent=2))
        return 0

    if not out_list:
        print("No lifecycle automation modules found.")
        return 0

    for a in out_list:
        st_str = "ENABLED" if a["enabled"] else "DISABLED"
        ev_str = ", ".join(a["events"])
        print(f"• {a['id']:22} [{st_str:8}] — {a['description']}")
        print(f"  events: {ev_str}")
        print(f"  path:   {a['path']}")
    return 0


def cmd_integrations(args: argparse.Namespace, paths: TaskPaths, cfg: dict[str, Any]) -> int:
    action = getattr(args, "integ_action", None) or "list"
    target = getattr(args, "target", None)
    tid = resolve_current_task_id(paths, getattr(args, "task", None), include_archived=True)
    task = load_task(paths, tid, include_archived=True) if tid else None

    if action == "list":
        integs = discover_integrations(paths, cfg)
        out_list = [
            {
                "id": i["id"],
                "enabled": i["enabled"],
                "description": i["description"],
                "capabilities": i["capabilities"],
                "path": i["path"],
            }
            for i in integs
        ]
        if getattr(args, "json", False):
            print(json.dumps(out_list, indent=2))
            return 0
        if not out_list:
            print("No modular integration providers found.")
            return 0
        for i in out_list:
            st_str = "ENABLED" if i["enabled"] else "DISABLED"
            caps_str = ", ".join(i["capabilities"])
            print(f"• {i['id']:22} [{st_str:8}] — {i['description']}")
            print(f"  capabilities: {caps_str}")
            print(f"  path:         {i['path']}")
        return 0

    if action == "candidates":
        kind = (target or "resource").strip()
        cands = query_integration_candidates(kind, paths, cfg, task=task)
        if getattr(args, "json", False):
            print(json.dumps(cands, indent=2))
            return 0
        if not cands:
            print(f"No candidates returned for '{kind}'.")
            return 0
        for c in cands:
            print(f"{c.get('value', ''):36} | {c.get('label', '')}")
        return 0

    if action == "options":
        field = (target or "resource.status").strip()
        res_ctx = {
            "category": getattr(args, "category", None),
            "provider": getattr(args, "provider", None),
            "ref": getattr(args, "ref", None),
        }
        opts = query_integration_field_options(
            field,
            paths,
            cfg,
            task=task,
            resource=res_ctx,
            category=getattr(args, "category", None),
            provider=getattr(args, "provider", None),
            repo=getattr(args, "repo", None),
        )
        if getattr(args, "json", False):
            print(json.dumps(opts, indent=2))
            return 0
        if not opts:
            print(f"No field options returned for '{field}'.")
            return 0
        for o in opts:
            print(f"{o.get('value', ''):28} | {o.get('label', '')}")
        return 0

    return 1


def cmd_add(args: argparse.Namespace, paths: TaskPaths, cfg: dict[str, Any]) -> int:
    tid = resolve_current_task_id(paths, getattr(args, "task", None))
    if not tid:
        print("Error: could not resolve active task. Pass --task <id>.", file=sys.stderr)
        return 1

    repo = getattr(args, "repo", None)
    if not repo:
        fzf_bin = resolve_bin("fzf", cfg, "fzf_bin")
        repos = discover_available_repos(cfg)
        if not repos:
            print("No repositories found in configured repo_roots.", file=sys.stderr)
            return 1

        res = subprocess.run(
            [
                fzf_bin, "-m",
                "--prompt=Add Repository > ",
                "--header=[Tab] Select Multiple Repos   [Enter] Confirm Selection",
            ],
            input="\n".join(repos),
            capture_output=True,
            text=True,
            check=False,
        )
        if res.returncode != 0 or not res.stdout.strip():
            return 0
        rc_final = 0
        for r_name in [r.strip() for r in res.stdout.strip().splitlines() if r.strip()]:
            rc = cmd_worktree_add(
                argparse.Namespace(
                    task=tid,
                    repo=r_name,
                    branch=getattr(args, "branch", None),
                    label=None,
                    focus=getattr(args, "focus", True),
                    no_herdr=getattr(args, "no_herdr", False),
                    json=getattr(args, "json", False),
                ),
                paths,
                cfg,
            )
            if rc != 0:
                rc_final = rc
        return rc_final

    return cmd_worktree_add(
        argparse.Namespace(
            task=tid,
            repo=repo,
            branch=getattr(args, "branch", None),
            label=None,
            focus=getattr(args, "focus", True),
            no_herdr=getattr(args, "no_herdr", False),
            json=getattr(args, "json", False),
        ),
        paths,
        cfg,
    )


def open_url_target(url: str) -> bool:
    target = url.strip()
    if not target or target.startswith("-"):
        return False
    parsed = urlparse(target)
    if parsed.scheme.lower() not in ALLOWED_OPEN_SCHEMES:
        print(
            f"Error: refusing to open unsupported URL scheme '{parsed.scheme or 'none'}': {target}",
            file=sys.stderr,
        )
        return False
    opener = "open" if sys.platform == "darwin" else "xdg-open"
    res = subprocess.run([opener, target], capture_output=True, check=False)
    return res.returncode == 0


def cmd_open(args: argparse.Namespace, paths: TaskPaths, cfg: dict[str, Any]) -> int:
    tid = resolve_current_task_id(paths, getattr(args, "task", None), include_archived=True)
    if not tid:
        print("Error: could not resolve active task. Pass --task <id>.", file=sys.stderr)
        return 1
    task = load_task(paths, tid, include_archived=True)
    if not task:
        print(f"Error: task '{tid}' not found.", file=sys.stderr)
        return 1

    resources = task.get("resources", [])
    if not resources:
        print(f"No resources linked to task '{tid}'.")
        return 1

    selector = (getattr(args, "selector", None) or "").strip().lower()
    cat_aliases = {
        "jira": "ticket", "ticket": "ticket", "tickets": "ticket",
        "slack": "conversation", "conversation": "conversation",
        "pr": "pull_request", "prs": "pull_request", "pull_request": "pull_request",
        "alert": "alert", "alerts": "alert",
        "doc": "doc", "docs": "doc",
    }

    matched: list[dict[str, Any]] = []
    if not selector:
        fzf_bin = resolve_bin("fzf", cfg, "fzf_bin")
        if (shutil.which(fzf_bin) or os.path.exists(fzf_bin)) and sys.stdin.isatty():
            lines = [
                f"{r['id']}\t[{r.get('category')}] {r.get('ref')} — {r.get('label', '')} ({r.get('url', '')})"
                for r in resources
            ]
            res = subprocess.run(
                [fzf_bin, "--with-nth=2..", "--delimiter=\t", "--prompt=Open Resource > "],
                input="\n".join(lines),
                capture_output=True,
                text=True,
                check=False,
            )
            if res.returncode == 0 and res.stdout.strip():
                chosen_id = res.stdout.strip().split("\t", 1)[0]
                matched = [r for r in resources if r.get("id") == chosen_id]
        else:
            matched = resources[:1]
    elif selector in cat_aliases:
        target_cat = cat_aliases[selector]
        matched = [r for r in resources if r.get("category") == target_cat]
    else:
        matched = [
            r for r in resources
            if selector in (r.get("id") or "").lower()
            or selector in (r.get("ref") or "").lower()
            or selector in (r.get("provider") or "").lower()
            or selector in (r.get("label") or "").lower()
        ]

    if not matched:
        print(f"No matching resources for '{selector}' in task '{tid}'.", file=sys.stderr)
        return 1

    opened_any = False
    for r in matched:
        target_url = r.get("url") or r.get("ref") or ""
        if target_url and open_url_target(target_url):
            print(f"Opened: {target_url}")
            opened_any = True
    return 0 if opened_any else 1


def _remove_task_worktrees_on_disk(
    task: dict[str, Any],
    paths: TaskPaths,
    cfg: dict[str, Any],
    delete_branches: bool = False,
) -> None:
    tid = task["id"]
    other_tasks = [t for t in list_all_tasks(paths) if t.get("id") != tid]
    in_use_wt_paths: set[str] = set()
    in_use_repo_branches: set[tuple[str, str]] = set()
    for ot in other_tasks:
        for owt in ot.get("worktrees", []):
            if owt.get("worktree_path"):
                in_use_wt_paths.add(os.path.realpath(owt["worktree_path"]))
            if owt.get("repo") and owt.get("branch"):
                in_use_repo_branches.add((owt["repo"], owt["branch"]))

    for wt in task.get("worktrees", []):
        wt_path_str = wt.get("worktree_path", "")
        if not wt_path_str:
            continue
        wt_path = Path(wt_path_str)
        real_wt_path = os.path.realpath(str(wt_path))
        if real_wt_path in in_use_wt_paths:
            continue

        repo_path = Path(wt.get("repo_path", ""))
        if wt_path.exists() and repo_path.exists():
            rm_cmd = ["git", "-C", str(repo_path), "worktree", "remove", "--force", str(wt_path)]
            res = subprocess.run(rm_cmd, capture_output=True, text=True, check=False)
            if res.returncode != 0 and wt_path.exists():
                shutil.rmtree(wt_path, ignore_errors=True)
        elif wt_path.exists():
            shutil.rmtree(wt_path, ignore_errors=True)

        if repo_path.exists():
            subprocess.run(["git", "-C", str(repo_path), "worktree", "prune"], capture_output=True, check=False)
            branch_name = wt.get("branch") or ""
            if (
                delete_branches
                and branch_name
                and not branch_name.startswith("-")
                and (wt.get("repo"), branch_name) not in in_use_repo_branches
            ):
                subprocess.run(
                    ["git", "-C", str(repo_path), "branch", "-D", "--", branch_name],
                    capture_output=True,
                    check=False,
                )

    # Remove task-scoped worktree container directory if empty
    wt_root = Path(os.path.expanduser(cfg.get("worktrees_root", DEFAULT_CONFIG["worktrees_root"])))
    task_wt_dir = wt_root / slugify(tid, max_len=48)
    if task_wt_dir.is_dir():
        try:
            task_wt_dir.rmdir()
        except OSError:
            pass


def cmd_cleanup(args: argparse.Namespace, paths: TaskPaths, cfg: dict[str, Any]) -> int:
    try:
        signal.signal(signal.SIGHUP, signal.SIG_IGN)
    except Exception:
        pass

    tid = resolve_current_task_id(paths, getattr(args, "task_id", None))
    if not tid:
        print("Error: could not resolve task to clean up. Pass <task-id>.", file=sys.stderr)
        return 1

    task = load_task(paths, tid)
    if not task:
        print(f"Error: active task '{tid}' not found.", file=sys.stderr)
        return 1

    force = bool(getattr(args, "force", False))

    dirty_reports: list[str] = []
    for wt in task.get("worktrees", []):
        safety = check_worktree_safety(wt.get("worktree_path", ""))
        if not safety["clean"]:
            dirty_reports.append(
                f"  - {wt['repo']} ({wt['worktree_path']}): {len(safety['dirty_files'])} uncommitted/untracked file(s)"
            )

    if dirty_reports and not force:
        msg = (
            f"Safety Audit Blocked Cleanup for '{tid}':\n"
            + "\n".join(dirty_reports)
            + "\nCommit/stash your changes or re-run with --force."
        )
        print(msg, file=sys.stderr)
        return 1

    ws_id = task.get("workspace_id")
    if ws_id and not getattr(args, "no_herdr", False):
        client = HerdrClient(cfg)
        client.close_workspace(ws_id, group=True)
        for wt in task.get("worktrees", []):
            if wt.get("workspace_id"):
                client.close_workspace(wt["workspace_id"])

    _remove_task_worktrees_on_disk(
        task,
        paths,
        cfg,
        delete_branches=bool(getattr(args, "delete_branches", False)),
    )

    auto_msgs: list[str] = []
    with task_store_lock(paths):
        fresh_task = load_task(paths, tid)
        if fresh_task:
            task = fresh_task
        old_status = task.get("status") or "in_progress"
        task["status"] = "archived"
        task["workspace_id"] = None
        for wt in task.get("worktrees", []):
            wt["workspace_id"] = None
            wt["tab_id"] = None
            wt["pane_id"] = None
            wt.pop("cockpit_panes", None)
        task["archived_at"] = now_iso()
        task["updated_at"] = now_iso()
        _, auto_msgs = dispatch_automation_event(
            "task.cleanup",
            task,
            paths,
            cfg,
            previous_status=old_status,
            new_status="archived",
        )
        atomic_write_json(paths.archive_file(tid), task)
        active_file = paths.task_file(tid)
        if active_file.exists():
            active_file.unlink()

    if getattr(args, "json", False):
        print(json.dumps({"archived": tid, "status": "archived", "messages": auto_msgs}, indent=2))
    else:
        print(f"Cleaned up and archived task '{tid}'.")
        for m in auto_msgs:
            print(f"  ↳ {m}")
    return 0


def cmd_sync_sidebar(args: argparse.Namespace, paths: TaskPaths, cfg: dict[str, Any]) -> int:
    herdr = HerdrClient(cfg)
    live_ws_ids = {w.get("workspace_id") for w in herdr.list_workspaces()}
    synced = 0
    for task in list_all_tasks(paths):
        if task.get("workspace_id") in live_ws_ids:
            if herdr.sync_sidebar_metadata(task):
                synced += 1
    if getattr(args, "json", False):
        print(json.dumps({"synced": synced}))
    return 0


# ---------------------------------------------------------------------------
# Mission Control Popup UI (fzf)
# ---------------------------------------------------------------------------

RESOURCE_CATEGORY_ICONS: dict[str, str] = {
    "ticket": "🎫",
    "pull_request": "🔀",
    "issue": "🐛",
    "conversation": "💬",
    "alert": "🚨",
    "doc": "📄",
    "custom": "🔗",
}


def format_fzf_resource_lines(task: dict[str, Any]) -> list[str]:
    lines: list[str] = []
    for r in task.get("resources", []):
        cat = r.get("category") or "custom"
        icon = RESOURCE_CATEGORY_ICONS.get(cat, "🔗")
        ref = r.get("ref") or r.get("id") or "res"
        label = r.get("label") or ""
        status = f" [{r['status']}]" if r.get("status") else ""
        url = r.get("url") or ""
        summary_tok = (r.get("summary") or "").replace("\t", " ").replace("\n", " ")
        display = f"{icon} [{cat}] {ref}{status} — {label}"
        if url and url != ref:
            display += f"  ({url})"
        lines.append(f"{r['id']}\t{display}\t{summary_tok}")
    lines.append("_add_\t➕ Add New Resource (Jira, GitHub PR, Slack, Alert, Doc, URL)...\tadd create new resource")
    lines.append("_pilot_\t🤖 Launch Task Pilot Agent on This Task (Link PRs/Tickets, Add Repos, Update Context)...\tpilot agent ai")
    return lines


def format_resource_preview(task: dict[str, Any], res_id: str, color: bool = True) -> str:
    c_bold = "\033[1m" if color else ""
    c_cyan = "\033[36m" if color else ""
    c_green = "\033[32m" if color else ""
    c_yellow = "\033[33m" if color else ""
    c_dim = "\033[2m" if color else ""
    c_reset = "\033[0m" if color else ""

    if res_id == "_pilot_":
        out = [
            f"{c_bold}{c_cyan}🤖 Launch Task Pilot Agent on '{task['id']}'{c_reset}",
            "",
            f"Press {c_bold}[Enter]{c_reset} or {c_bold}[Ctrl-P]{c_reset} to launch an AI Pilot Agent scoped to this task:",
            f"  • {c_bold}Active Task{c_reset}: {task.get('title', '')} ({task['id']})",
            f"  • {c_bold}Env Bound{c_reset}:   HERDR_TASK_ID={task['id']}  HERDR_PILOT_MODE=existing_task",
            "",
            f"What the Task Pilot can do for '{task['id']}':",
            f"  • Link GitHub PRs, Jira tickets, Slack threads, alerts, or docs (`herdr-task link`)",
            f"  • Add repository worktrees and provision Cockpit tabs (`herdr-task add <repo>`)",
            f"  • Fetch Jira/GitHub context and save summaries (`herdr-task link ... --summary`)",
            f"  • Record cross-repo handoff notes (`herdr-task note \"...\"`)",
        ]
        if task.get("brief"):
            out.extend(["", f"{c_bold}Brief:{c_reset} {task['brief']}"])
        return "\n".join(out)

    if res_id == "_add_" or not res_id:
        out = [
            f"{c_bold}{c_cyan}➕ Add a New Resource to '{task['id']}'{c_reset}",
            "",
            f"Press {c_bold}[Enter]{c_reset} or {c_bold}[Ctrl-N]{c_reset} to link a new resource:",
            f"  • {c_bold}Jira Ticket{c_reset}:       e.g. PROJ-123 or https://.../browse/PROJ-123",
            f"  • {c_bold}GitHub PR / Issue{c_reset}: e.g. org/repo#42 or https://github.com/org/repo/pull/42",
            f"  • {c_bold}Slack Thread{c_reset}:      https://...slack.com/archives/...",
            f"  • {c_bold}Alert / Doc{c_reset}:       Grafana, Datadog, Sentry, Notion, Figma, or any URL",
            "",
            f"{c_bold}Task Context:{c_reset} {task.get('title', '')}",
        ]
        if task.get("brief"):
            out.append(f"{c_bold}Brief:{c_reset} {task['brief']}")
        return "\n".join(out)

    target_res = next(
        (r for r in task.get("resources", []) if r.get("id") == res_id or r.get("ref") == res_id),
        None,
    )
    if not target_res:
        return f"Resource '{res_id}' not found in task '{task['id']}'."

    cat = target_res.get("category") or "custom"
    icon = RESOURCE_CATEGORY_ICONS.get(cat, "🔗")
    status_str = f" [{target_res['status']}]" if target_res.get("status") else ""
    out = [
        f"{c_bold}{c_cyan}{icon} [{cat.upper()}] {target_res.get('ref', '')}{c_yellow}{status_str}{c_reset} — {c_bold}{target_res.get('label', '')}{c_reset}",
        "",
        f"  {c_bold}ID:{c_reset}          {target_res.get('id', '')}",
        f"  {c_bold}Provider:{c_reset}    {target_res.get('provider', 'custom')}",
        f"  {c_bold}Category:{c_reset}    {cat}",
        f"  {c_bold}Status:{c_reset}      {c_yellow}{target_res.get('status') or '(none)'}{c_reset}",
        f"  {c_bold}URL:{c_reset}         {c_green}{target_res.get('url') or '(none)'}{c_reset}",
        f"  {c_bold}Added By:{c_reset}    {target_res.get('added_by', 'user')}  {c_dim}(updated: {target_res.get('updated_at', '-')}){c_reset}",
        "",
        f"{c_bold}Summary / Context:{c_reset}",
        f"  {target_res['summary']}" if target_res.get("summary") else f"  {c_dim}(No summary set — press [Ctrl-E] to add or update summary){c_reset}",
        "",
        f"{c_dim}────────────────────────────────────────────────────────────{c_reset}",
        f"{c_bold}Task:{c_reset} {task.get('title', '')} ({task['id']})",
    ]
    if task.get("brief"):
        out.append(f"{c_bold}Brief:{c_reset} {task['brief']}")
    notes = task.get("notes", [])
    if notes:
        out.append(f"{c_bold}Recent Notes ({len(notes)}):{c_reset}")
        for n in notes[-3:]:
            out.append(f"  > [{n.get('author', 'note')}] {n.get('text', '')}")
    return "\n".join(out)


def _select_pilot_choice_and_cmd(
    cfg: dict[str, Any],
    fzf_bin: str,
    prompt: str,
    header: str,
    include_quick: bool = False,
) -> tuple[str | None, list[str]]:
    models = cfg.get("pilot_models") or DEFAULT_CONFIG["pilot_models"]
    menu_items: list[str] = []
    if include_quick:
        menu_items.append("quick\t⚡ Interactive Task Form (0 Tokens / 0 AIC) — Field Navigator, Jira/PR Picker & Dropdowns")
    model_by_id: dict[str, dict[str, Any]] = {}
    for m in models:
        if isinstance(m, dict) and m.get("id") and m.get("label"):
            menu_items.append(f"{m['id']}\t{m['label']}")
            model_by_id[m["id"]] = m

    res = subprocess.run(
        [
            fzf_bin,
            "--delimiter=\t",
            "--with-nth=2",
            f"--prompt={prompt}",
            f"--header={header}",
        ],
        input="\n".join(menu_items),
        capture_output=True,
        text=True,
        check=False,
    )
    if res.returncode != 0 or not res.stdout.strip():
        return None, []

    choice = res.stdout.strip().split("\t", 1)[0]
    if choice == "quick":
        return "quick", []

    spec = model_by_id.get(choice)
    if spec:
        bin_name = spec.get("bin") or "copilot"
        c_bin = resolve_bin(bin_name)
        cmd_list = [c_bin]
        if spec.get("model"):
            cmd_list.extend(["--model", str(spec["model"])])
        return choice, cmd_list

    cand = cfg.get("default_pilot_bin") or cfg.get("default_worker_kind") or "copilot"
    c_bin = resolve_bin(str(cand))
    return choice, [c_bin]


