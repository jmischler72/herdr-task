def prompt_inline_text(
    label: str,
    current_value: str = "",
    allow_clear: bool = True,
    hint: str = "",
) -> str | None:
    """
    Prompts for a single text field. When running in an interactive terminal,
    pre-fills `current_value` via `readline` so the user can edit in-place with
    arrow keys and Backspace.
    """
    cur = str(current_value or "")
    clear_hint = "  |  Type '-' to clear" if allow_clear and cur else ""
    extra_hint = f"  |  {hint}" if hint else ""
    print(f"\n--- ✏️  Edit {label} ---")
    print(f"Press [Enter] to confirm{clear_hint}{extra_hint}  |  [Ctrl-C] Cancel")

    if sys.stdin.isatty():
        try:
            import readline
            readline.set_startup_hook(lambda: readline.insert_text(cur))
        except Exception:
            readline = None  # type: ignore[assignment]
        try:
            raw = input(f"{label}: ")
        except (EOFError, KeyboardInterrupt):
            print()
            return None
        finally:
            if "readline" in locals() and readline is not None:
                try:
                    readline.set_startup_hook(None)
                except Exception:
                    pass
        val = raw.strip()
        if val == "-" and allow_clear:
            return ""
        return val

    print(f"{label} [{cur or 'empty'}]: ", end="", flush=True)
    line = sys.stdin.readline()
    if not line:
        return None
    val = line.strip()
    if val == "-" and allow_clear:
        return ""
    if val == "":
        return cur
    return val


def prompt_fzf_dropdown(
    fzf_bin: str,
    options: list[dict[str, Any]],
    prompt: str,
    header: str,
    current_value: str = "",
    allow_custom: bool = False,
    allow_clear: bool = False,
) -> str | None:
    """
    Interactive `fzf` dropdown for fixed or integration-supplied field options.
    Supports `action == 'open_url'` entries (opens browser and stays in dropdown)
    and `allow_custom=True` (via `--print-query` or 'Type custom value...').
    """
    cur_norm = (current_value or "").strip().lower()
    while True:
        rows: list[str] = []
        by_key: dict[str, dict[str, Any]] = {}
        for idx, opt in enumerate(options):
            val = str(opt.get("value") or "").strip()
            lbl = str(opt.get("label") or val).strip()
            key = f"opt_{idx}"
            is_cur = bool(cur_norm and val.lower() == cur_norm)
            suffix = "  ✨ (current)" if is_cur else ""
            rows.append(f"{key}\t{lbl}{suffix}")
            by_key[key] = opt

        if allow_custom:
            rows.append("__custom__\t✏️  Type a custom value manually...")
        if allow_clear and current_value:
            rows.append("__clear__\t🗑️  Clear field (set to empty)")

        cmd = [
            fzf_bin,
            "--ansi",
            "--delimiter=\t",
            "--with-nth=2",
            f"--prompt={prompt}",
            f"--header={header}",
        ]
        if allow_custom:
            cmd.append("--print-query")

        res = subprocess.run(
            cmd,
            input="\n".join(rows),
            capture_output=True,
            text=True,
            check=False,
        )
        out_lines = [ln for ln in res.stdout.splitlines() if ln.strip() or allow_custom]
        if not allow_custom:
            if res.returncode != 0 or not res.stdout.strip():
                return None
            chosen_key = res.stdout.strip().splitlines()[0].split("\t", 1)[0].strip()
            query_str = ""
        else:
            if res.returncode not in (0, 1) or not out_lines:
                return None
            query_str = out_lines[0].strip() if len(out_lines) >= 1 else ""
            chosen_line = out_lines[1].strip() if len(out_lines) >= 2 else ""
            chosen_key = chosen_line.split("\t", 1)[0].strip() if chosen_line else ""
            if not chosen_key:
                return query_str if query_str else None

        if chosen_key == "__clear__":
            return ""
        if chosen_key == "__custom__":
            typed = prompt_inline_text(prompt.rstrip(" >"), current_value=current_value, allow_clear=allow_clear)
            return typed

        chosen_opt = by_key.get(chosen_key)
        if not chosen_opt:
            return query_str if (allow_custom and query_str) else None

        if chosen_opt.get("action") == "open_url" and chosen_opt.get("url"):
            open_url_target(str(chosen_opt["url"]))
            continue

        return str(chosen_opt.get("value") or "")


def _resolve_default_jira_browse_url(cfg: dict[str, Any]) -> str:
    raw = str(cfg.get("jira_base_url") or "").strip().rstrip("/")
    if not raw or "your-org.atlassian.net" in raw:
        auto_jira = (cfg.get("automations") or {}).get("jira_status_sync")
        if isinstance(auto_jira, dict) and auto_jira.get("base_url"):
            raw = str(auto_jira["base_url"]).strip().rstrip("/")
    if raw.endswith("/browse"):
        raw = raw[:-len("/browse")].rstrip("/")
    if not raw or "your-org.atlassian.net" in raw:
        return ""
    return f"{raw}/jira/your-work"


def prompt_integration_candidate(
    fzf_bin: str,
    kind: str,
    paths: TaskPaths,
    cfg: dict[str, Any],
    prompt: str,
    header: str,
    current_value: str = "",
    task: dict[str, Any] | None = None,
    repos: list[str] | None = None,
    allow_clear: bool = True,
) -> tuple[str | None, dict[str, Any] | None]:
    """
    Opens an `fzf` picker populated by modular integrations (`provide_candidates`)
    for Jira tickets, GitHub PRs, or general resources.
    Includes browser redirect rows (`🌐 Open Jira in Browser...`, `🌐 Open GitHub PRs...`)
    and `[Ctrl-O]` to open in browser without leaving the picker!
    """
    self_bin = f"{shlex.quote(sys.executable)} {shlex.quote(os.path.abspath(__file__))}"

    with tempfile.TemporaryDirectory(prefix="herdr_cand_") as tmp_dir:
        preview_file = Path(tmp_dir) / "candidates.json"

        while True:
            cands = query_integration_candidates(
                kind,
                paths,
                cfg,
                task=task,
                repos=repos,
                current_ref=current_value,
            )

            selectable_cands = [c for c in cands if c.get("action") != "open_url"]
            browser_cands = [c for c in cands if c.get("action") == "open_url"]

            rows: list[str] = []
            by_key: dict[str, dict[str, Any]] = {}
            previews_by_key: dict[str, str] = {}

            cur_norm = (current_value or "").strip().lower()
            idx = 0
            for c in selectable_cands:
                key = f"cand_{idx}"
                idx += 1
                val = str(c.get("value") or "").strip()
                lbl = str(c.get("label") or val).strip()
                is_cur = bool(cur_norm and val.lower() == cur_norm)
                suffix = "  ✨ (current)" if is_cur else ""
                rows.append(f"{key}\t{lbl}{suffix}")
                by_key[key] = c
                previews_by_key[key] = str(c.get("preview") or f"{lbl}\n\nValue: {val}")

            for c in browser_cands:
                key = f"open_{idx}"
                idx += 1
                lbl = str(c.get("label") or c.get("url") or "Open in Browser").strip()
                rows.append(f"{key}\t{lbl}")
                by_key[key] = c
                previews_by_key[key] = str(c.get("preview") or f"🌐 Open in Browser:\n{c.get('url')}")

            rows.append("__manual__\t✏️  Enter Key, Shorthand (PROJ-123 / repo#42), or URL manually...")
            previews_by_key["__manual__"] = (
                "✏️  Manual Input\n\n"
                "Select this option (or type directly into the fzf search bar and press [Enter]) "
                "to enter any Jira ticket key (PROJ-123), GitHub PR shorthand (org/repo#42), "
                "Slack thread URL, Alert URL, or Doc URL."
            )

            if allow_clear and current_value:
                rows.append("__clear__\t🗑️  Clear value (unlink / set to empty)")
                previews_by_key["__clear__"] = f"🗑️  Clear current value ({current_value})"

            preview_file.write_text(json.dumps(previews_by_key, ensure_ascii=False), encoding="utf-8")
            q_pfile = shlex.quote(str(preview_file))

            cmd = [
                fzf_bin,
                "--ansi",
                "--delimiter=\t",
                "--with-nth=2",
                "--print-query",
                "--expect=ctrl-o",
                f"--prompt={prompt}",
                f"--header={header}",
                "--preview",
                f"{self_bin} _popup-action preview-candidate {q_pfile} {{1}}",
                "--preview-window",
                "down:55%:wrap",
            ]

            res = subprocess.run(
                cmd,
                input="\n".join(rows),
                capture_output=True,
                text=True,
                check=False,
            )
            raw_lines = res.stdout.splitlines()
            if res.returncode not in (0, 1) or not raw_lines:
                return None, None

            query_str = raw_lines[0].strip() if len(raw_lines) >= 1 else ""
            expect_key = raw_lines[1].strip() if len(raw_lines) >= 2 else ""
            selected_line = raw_lines[2].strip() if len(raw_lines) >= 3 else ""
            chosen_key = selected_line.split("\t", 1)[0].strip() if selected_line else ""

            if expect_key == "ctrl-o":
                chosen_item = by_key.get(chosen_key)
                target_open_url = ""
                if chosen_item:
                    target_open_url = str(
                        chosen_item.get("url")
                        or (chosen_item.get("resource_patch") or {}).get("url")
                        or ""
                    )
                if not target_open_url and browser_cands:
                    target_open_url = str(browser_cands[0].get("url") or "")
                if not target_open_url:
                    target_open_url = _resolve_default_jira_browse_url(cfg)
                if target_open_url:
                    open_url_target(target_open_url)
                continue

            if not chosen_key:
                if query_str:
                    return query_str, None
                return None, None

            if chosen_key == "__clear__":
                return "", None

            if chosen_key == "__manual__":
                default_init = query_str if query_str else current_value
                typed = prompt_inline_text(
                    prompt.rstrip(" >"),
                    current_value=default_init,
                    allow_clear=allow_clear,
                    hint="e.g. PROJ-123, org/repo#42, or https://...",
                )
                return typed, None

            chosen_item = by_key.get(chosen_key)
            if not chosen_item:
                return (query_str, None) if query_str else (None, None)

            if chosen_item.get("action") == "open_url" and chosen_item.get("url"):
                open_url_target(str(chosen_item["url"]))
                continue

            val = str(chosen_item.get("value") or "").strip()
            patch = chosen_item.get("resource_patch") if isinstance(chosen_item.get("resource_patch"), dict) else None
            return val, patch


def apply_resource_target_to_draft(
    draft: dict[str, Any],
    raw_target: str,
    cfg: dict[str, Any],
    paths: TaskPaths,
    task: dict[str, Any] | None = None,
    candidate_patch: dict[str, Any] | None = None,
) -> list[str]:
    """
    Classifies and enriches `raw_target` (via GitHub PR metadata and modular integrations
    such as Jira REST API v3) and updates the resource `draft` in-place.
    """
    clean = raw_target.strip()
    if not clean:
        draft["ref"] = ""
        return []

    old_ref = draft.get("ref") or ""
    target_changed = clean != old_ref

    classified = classify_resource(clean, cfg, fetch_remote=True)
    msgs = enrich_draft_resource_via_integrations(classified, paths, cfg, task=task)

    if isinstance(candidate_patch, dict):
        for k in ("ref", "url", "category", "provider", "label", "status", "summary"):
            if candidate_patch.get(k):
                classified[k] = candidate_patch[k]
        if isinstance(candidate_patch.get("metadata"), dict):
            classified.setdefault("metadata", {}).update(candidate_patch["metadata"])

    draft["ref"] = classified.get("ref") or clean
    draft["url"] = classified.get("url") or clean
    draft["category"] = classified.get("category") or draft.get("category") or "custom"
    draft["provider"] = classified.get("provider") or draft.get("provider") or "custom"
    draft.setdefault("metadata", {}).update(classified.get("metadata") or {})

    if target_changed or not draft.get("label") or draft.get("label") == old_ref:
        draft["label"] = classified.get("label") or draft["ref"]
    if (target_changed or not draft.get("status")) and classified.get("status"):
        draft["status"] = classified["status"]
    if (target_changed or not draft.get("summary")) and classified.get("summary"):
        draft["summary"] = classified["summary"]

    draft["enrichment_messages"] = msgs
    return msgs


def format_form_preview(state: dict[str, Any], selected_key: str, color: bool = True) -> str:
    c_bold = "\033[1m" if color else ""
    c_cyan = "\033[36m" if color else ""
    c_green = "\033[32m" if color else ""
    c_yellow = "\033[33m" if color else ""
    c_magenta = "\033[35m" if color else ""
    c_dim = "\033[2m" if color else ""
    c_reset = "\033[0m" if color else ""

    form_type = state.get("form_type") or "task"
    mode = state.get("mode") or "edit"
    draft = state.get("draft") or {}
    orig = state.get("original") or {}

    field_hints: dict[str, str] = {
        "target": "🎯 Press [Enter] to pick from My Jira Tickets, Open GitHub PRs, open Jira/GitHub in Browser, or type a key/URL.",
        "label": "🏷️  Press [Enter] to edit the display label in-place (pre-filled with current value).",
        "category": "📂 Press [Enter] to open the Category dropdown (ticket, pull_request, issue, conversation, alert, doc, custom).",
        "provider": "🔌 Press [Enter] to open the Provider dropdown (jira, github, slack, grafana, notion, ...) or type custom.",
        "status": "🚦 Press [Enter] to open the Status dropdown (populated from modular integrations e.g. Jira transitions / GitHub states).",
        "summary": "📝 Press [Enter] to edit the technical summary in-place (avoids redundant AI/MCP lookups).",
        "url": "🔗 Press [Enter] to edit the target URL in-place (or press [Ctrl-O] to open it in browser).",
        "sync_branch": "🌿 Press [Enter] to toggle switching the attached repo worktree to match this PR's branch on save.",
        "open_browser": "🌐 Press [Enter] or [Ctrl-O] to open the resource or Jira/GitHub dashboard in your browser.",
        "title": "📌 Press [Enter] to edit the task title in-place (also updates the Herdr workspace label).",
        "jira_ticket": "🎫 Press [Enter] to list your assigned Jira tickets, redirect to Jira in Browser, or enter a ticket key (auto-fills Title & ID!).",
        "pr_links": "🔀 Press [Enter] to pick from open GitHub PRs (`gh pr list`), open GitHub in Browser, or add a PR/resource link.",
        "repos": "📦 Press [Enter] to open the multi-select Repository picker (`[Tab]` to toggle multiple repos from repo_roots).",
        "default_branch": "🌿 Press [Enter] to pick a Git branch from local/remote refs or type a custom branch name.",
        "brief": "📝 Press [Enter] to edit the shared multi-repo technical brief in-place.",
        "id": "🆔 Press [Enter] to customize the task ID slug (auto-generated from Jira Ticket + Title by default).",
        "open_jira": "🌐 Press [Enter] or [Ctrl-O] to open Jira in your browser to check or search your tickets.",
        "_save_": "✅ Press [Enter] (or [Ctrl-S] from any row) to validate and save all changes.",
        "_cancel_": "❌ Press [Enter] (or [Esc]) to discard changes and return.",
    }
    if selected_key.startswith("repo_branch:"):
        r_name = selected_key.split(":", 1)[1]
        hint_text = f"🌿 Press [Enter] to open the Git branch dropdown (local & remote branches) for repository '{r_name}'."
    else:
        hint_text = field_hints.get(selected_key, "Select any field and press [Enter] to edit it, or [Ctrl-S] to save.")

    def _diff_badge(key: str) -> str:
        if mode != "edit":
            return ""
        if draft.get(key) != orig.get(key):
            return f"  {c_yellow}✨ (modified){c_reset}"
        return ""

    lines: list[str] = [
        f"{c_bold}{c_magenta}💡 Selected Field:{c_reset} {hint_text}",
        f"{c_dim}────────────────────────────────────────────────────────────────────────────{c_reset}",
    ]

    if form_type == "resource":
        cat = draft.get("category") or "custom"
        icon = RESOURCE_CATEGORY_ICONS.get(cat, "🔗")
        title_str = "➕ New Resource Draft" if mode == "add" else f"✏️  Editing Resource [{orig.get('ref') or draft.get('ref')}]"
        lines.extend([
            f"{c_bold}{c_cyan}{title_str}  (Task: {state.get('task_id', '')}){c_reset}",
            "",
            f"  {c_bold}Target / Ref:{c_reset}   {draft.get('ref') or f'{c_dim}(not set — select Target row to pick Jira/PR/URL){c_reset}'}{_diff_badge('ref')}",
            f"  {c_bold}Display Label:{c_reset}  {draft.get('label') or f'{c_dim}(auto){c_reset}'}{_diff_badge('label')}",
            f"  {c_bold}Category:{c_reset}       {icon} {cat}{_diff_badge('category')}",
            f"  {c_bold}Provider:{c_reset}       {draft.get('provider') or 'custom'}{_diff_badge('provider')}",
            f"  {c_bold}Status Badge:{c_reset}   {c_yellow}{draft.get('status') or '(none)'}{c_reset}{_diff_badge('status')}",
            f"  {c_bold}URL:{c_reset}            {c_green}{draft.get('url') or '(none)'}{c_reset}{_diff_badge('url')}",
            f"  {c_bold}Summary:{c_reset}        {draft.get('summary') or f'{c_dim}(none){c_reset}'}{_diff_badge('summary')}",
        ])
        meta = draft.get("metadata") or {}
        if meta.get("branch") or meta.get("repo"):
            lines.append(
                f"  {c_bold}PR Metadata:{c_reset}    repo={meta.get('repo', '-')}  branch={c_yellow}{meta.get('branch', '-')}{c_reset}"
            )
    else:
        st = (draft.get("status") or "in_progress").lower()
        st_icon = TASK_STATUS_ICONS.get(st, "🚧")
        hdr = "⚡ New Task Draft" if mode == "create" else f"✏️  Editing Task [{state.get('task_id', '')}]"
        repos_list = draft.get("repos") or []
        repo_branches = draft.get("repo_branches") or {}
        pr_links = draft.get("pr_links") or []

        lines.extend([
            f"{c_bold}{c_cyan}{hdr}{c_reset}",
            "",
            f"  {c_bold}Task ID:{c_reset}        {draft.get('id') or '(auto)'}",
            f"  {c_bold}Title:{c_reset}          {draft.get('title') or f'{c_dim}Untitled Task{c_reset}'}{_diff_badge('title')}",
            f"  {c_bold}Status:{c_reset}         {st_icon} {st.upper()}{_diff_badge('status')}",
            f"  {c_bold}Jira Ticket:{c_reset}    {draft.get('jira_ticket_display') or draft.get('jira_ticket') or f'{c_dim}(none){c_reset}'}{_diff_badge('jira_ticket')}",
            f"  {c_bold}PR / Links:{c_reset}     {', '.join(pr_links) if pr_links else f'{c_dim}(none){c_reset}'}{_diff_badge('pr_links')}",
            f"  {c_bold}Repositories:{c_reset}   {', '.join(repos_list) if repos_list else f'{c_dim}(none selected){c_reset}'}{_diff_badge('repos')}",
            f"  {c_bold}Default Branch:{c_reset} {c_yellow}{draft.get('default_branch') or '(auto)'}{c_reset}{_diff_badge('default_branch')}",
        ])
        for r_name in repos_list:
            rb = repo_branches.get(r_name) or draft.get("default_branch") or f"feat/{draft.get('id') or 'task'}"
            orig_rb = (orig.get("repo_branches") or {}).get(r_name)
            mod_tag = f"  {c_yellow}✨ (modified){c_reset}" if (mode == "edit" and orig_rb and rb != orig_rb) else ""
            lines.append(f"    ↳ {c_bold}{r_name}{c_reset}: {c_yellow}{rb}{c_reset}{mod_tag}")
        lines.append(f"  {c_bold}Brief:{c_reset}          {draft.get('brief') or f'{c_dim}(none){c_reset}'}{_diff_badge('brief')}")

    enr = draft.get("enrichment_messages") or []
    if enr:
        lines.extend(["", f"{c_bold}{c_green}🔌 Integration Enrichment:{c_reset}"])
        for m in enr[-4:]:
            lines.append(f"  • {m}")

    lines.extend([
        "",
        f"{c_dim}Shortcuts: [Enter] Edit Selected Field  |  [Ctrl-S] Save & Apply  |  [Ctrl-O] Open in Browser  |  [Esc] Cancel{c_reset}",
    ])
    return "\n".join(lines)


def _format_ResourceForm_rows(draft: dict[str, Any], mode: str) -> list[str]:
    ref = draft.get("ref") or ""
    lbl = draft.get("label") or ""
    cat = draft.get("category") or "custom"
    cat_icon = RESOURCE_CATEGORY_ICONS.get(cat, "🔗")
    prov = draft.get("provider") or "custom"
    st = draft.get("status") or ""
    summary = (draft.get("summary") or "").replace("\t", " ").replace("\n", " ")
    url = draft.get("url") or ""
    meta = draft.get("metadata") or {}

    rows = [
        f"target\t🎯 Target / Reference   : {ref or '(click to pick Jira Ticket, GitHub PR, or enter URL...)'}",
        f"label\t🏷️  Display Label        : {lbl or '(auto)'}",
        f"category\t📂 Category             : {cat_icon} {cat}  [dropdown]",
        f"provider\t🔌 Provider             : {prov}  [dropdown]",
        f"status\t🚦 Status Badge         : {st or '(none)'}  [dropdown]",
        f"summary\t📝 Summary              : {(summary[:64] + '…') if len(summary) > 64 else (summary or '(none)')}",
        f"url\t🔗 URL                  : {url or '(none)'}",
    ]
    if cat == "pull_request" or meta.get("branch"):
        sync_str = "Yes" if draft.get("sync_branch") else "No"
        br_hint = f" ({meta.get('repo', 'repo')} -> {meta['branch']})" if meta.get("branch") else ""
        rows.append(f"sync_branch\t🌿 Sync Worktree Branch : {sync_str}{br_hint}  [toggle]")

    open_lbl = url if url.startswith(("http://", "https://")) else "Open Jira / GitHub Dashboard in Browser"
    rows.append(f"open_browser\t🌐 Open in Browser      : {open_lbl}")
    save_txt = "✅ Save New Resource" if mode == "add" else "✅ Save Resource Changes"
    rows.append(f"_save_\t{save_txt}  (or press [Ctrl-S])")
    rows.append("_cancel_\t❌ Cancel  (or press [Esc])")
    return rows


def interactive_resource_form(
    tid: str,
    paths: TaskPaths,
    cfg: dict[str, Any],
    resource_id: str | None = None,
    initial_target: str | None = None,
    no_herdr: bool = False,
) -> int:
    """
    Interactive field-navigator form for adding or editing a resource on task `tid`.
    Displays all resource fields at once in `fzf`, provides dropdowns for Category,
    Provider, Status Badge, and Jira/GitHub candidates, and supports browser redirection.
    """
    task = load_task(paths, tid)
    if not task:
        print(f"Error: task '{tid}' not found.", file=sys.stderr)
        return 1

    target_res = None
    if resource_id and resource_id not in ("_add_", "_pilot_"):
        target_res = next(
            (r for r in task.get("resources", []) if r.get("id") == resource_id or r.get("ref") == resource_id),
            None,
        )

    mode = "edit" if target_res else "add"
    if target_res:
        draft: dict[str, Any] = {
            "id": target_res.get("id"),
            "ref": target_res.get("ref") or "",
            "label": target_res.get("label") or "",
            "category": target_res.get("category") or "custom",
            "provider": target_res.get("provider") or "custom",
            "status": target_res.get("status") or "",
            "summary": target_res.get("summary") or "",
            "url": target_res.get("url") or "",
            "metadata": json.loads(json.dumps(target_res.get("metadata") or {})),
            "sync_branch": False,
            "enrichment_messages": [],
        }
    else:
        draft = {
            "id": None,
            "ref": "",
            "label": "",
            "category": "ticket",
            "provider": "jira",
            "status": "",
            "summary": "",
            "url": "",
            "metadata": {},
            "sync_branch": False,
            "enrichment_messages": [],
        }
        if initial_target:
            apply_resource_target_to_draft(draft, initial_target, cfg, paths, task=task)

    original = json.loads(json.dumps(draft))
    fzf_bin = resolve_bin("fzf", cfg, "fzf_bin")
    self_bin = f"{shlex.quote(sys.executable)} {shlex.quote(os.path.abspath(__file__))}"

    with tempfile.TemporaryDirectory(prefix="herdr_res_form_") as tmp_dir:
        state_file = Path(tmp_dir) / "form_state.json"

        while True:
            task = load_task(paths, tid) or task
            state_payload = {
                "form_type": "resource",
                "mode": mode,
                "task_id": tid,
                "draft": draft,
                "original": original,
            }
            state_file.write_text(json.dumps(state_payload, ensure_ascii=False), encoding="utf-8")
            q_sfile = shlex.quote(str(state_file))

            rows = _format_ResourceForm_rows(draft, mode)
            title_hdr = (
                f"Add Resource to '{tid}'  |  [Enter] Edit Field  [Ctrl-S] Save  [Ctrl-O] Browser  [Esc] Cancel"
                if mode == "add"
                else f"Edit Resource [{draft.get('ref')}]  |  [Enter] Edit Field  [Ctrl-S] Save  [Ctrl-O] Browser  [Esc] Cancel"
            )

            cmd = [
                fzf_bin,
                "--ansi",
                "--delimiter=\t",
                "--with-nth=2",
                "--expect=ctrl-s,ctrl-o",
                "--header",
                title_hdr,
                "--prompt",
                f"{'Add' if mode == 'add' else 'Edit'} Resource ({tid}) > ",
                "--preview",
                f"{self_bin} _popup-action preview-form {q_sfile} {{1}}",
                "--preview-window",
                "down:58%:wrap",
            ]

            res = subprocess.run(cmd, input="\n".join(rows), capture_output=True, text=True, check=False)
            if res.returncode != 0 or not res.stdout.strip():
                return 0

            out_lines = res.stdout.splitlines()
            expect_key = out_lines[0].strip() if len(out_lines) >= 1 else ""
            sel_line = out_lines[1].strip() if len(out_lines) >= 2 else ""
            field_key = sel_line.split("\t", 1)[0].strip() if sel_line else ""

            if expect_key == "ctrl-o" or field_key == "open_browser":
                open_url = draft.get("url") or ""
                if not open_url.startswith(("http://", "https://", "slack://")):
                    open_url = _resolve_default_jira_browse_url(cfg) or "https://github.com/pulls"
                open_url_target(open_url)
                continue

            if expect_key == "ctrl-s" or field_key == "_save_":
                if not (draft.get("ref") or draft.get("url")):
                    # Prompt for Target if user hit Save before picking one
                    chosen_val, cand_patch = prompt_integration_candidate(
                        fzf_bin,
                        "resource",
                        paths,
                        cfg,
                        prompt="Select Ticket, PR, or Enter URL > ",
                        header="[Enter] Select or Type Key/URL  |  [Ctrl-O] Open in Browser  |  [Esc] Cancel",
                        current_value="",
                        task=task,
                        allow_clear=False,
                    )
                    if not chosen_val:
                        continue
                    apply_resource_target_to_draft(draft, chosen_val, cfg, paths, task=task, candidate_patch=cand_patch)

                if mode == "edit" and target_res:
                    with task_store_lock(paths):
                        task_fresh = load_task(paths, tid)
                        if not task_fresh:
                            return 1
                        for r in task_fresh.get("resources", []):
                            if r.get("id") == target_res.get("id"):
                                r["ref"] = draft["ref"] or r.get("ref") or ""
                                r["label"] = draft["label"]
                                r["category"] = draft["category"] or "custom"
                                r["provider"] = draft["provider"] or "custom"
                                r["status"] = draft["status"] or None
                                r["summary"] = draft["summary"] or None
                                r["url"] = draft["url"] or ""
                                if draft.get("metadata"):
                                    r.setdefault("metadata", {}).update(draft["metadata"])
                                r["updated_at"] = now_iso()
                                break
                        task_fresh["updated_at"] = now_iso()
                        atomic_write_json(paths.task_file(tid), task_fresh)
                    if not no_herdr:
                        HerdrClient(cfg).sync_sidebar_metadata(task_fresh)
                    return 0

                target_arg = draft.get("url") if (draft.get("url") or "").startswith(("http://", "https://", "slack://")) and draft.get("category") != "ticket" else (draft.get("ref") or draft.get("url") or "")
                return cmd_link(
                    argparse.Namespace(
                        target=target_arg,
                        task=tid,
                        label=draft.get("label") or None,
                        status=draft.get("status") or None,
                        summary=draft.get("summary") or None,
                        category=draft.get("category") or None,
                        provider=draft.get("provider") or None,
                        added_by=None,
                        metadata=None,
                        sync_branch=bool(draft.get("sync_branch")),
                        no_herdr=no_herdr,
                        json=False,
                    ),
                    paths,
                    cfg,
                )

            if field_key == "_cancel_" or not field_key:
                return 0

            if field_key == "target":
                chosen_val, cand_patch = prompt_integration_candidate(
                    fzf_bin,
                    "resource",
                    paths,
                    cfg,
                    prompt="Target (Jira Ticket, GitHub PR, or URL) > ",
                    header="[Enter] Pick Ticket/PR or Type Key/URL  |  [Ctrl-O] Open in Browser  |  [Esc] Back",
                    current_value=draft.get("ref") or "",
                    task=task,
                    allow_clear=False,
                )
                if chosen_val is not None and chosen_val != "":
                    apply_resource_target_to_draft(draft, chosen_val, cfg, paths, task=task, candidate_patch=cand_patch)

            elif field_key == "label":
                new_lbl = prompt_inline_text("Display Label", current_value=draft.get("label") or "", allow_clear=True)
                if new_lbl is not None:
                    draft["label"] = new_lbl

            elif field_key == "category":
                cat_opts = [{"value": k, "label": lbl} for k, lbl in KNOWN_RESOURCE_CATEGORIES]
                chosen_cat = prompt_fzf_dropdown(
                    fzf_bin,
                    cat_opts,
                    prompt="Resource Category > ",
                    header="Select resource category ([Esc] Cancel):",
                    current_value=draft.get("category") or "custom",
                    allow_custom=False,
                )
                if chosen_cat:
                    draft["category"] = chosen_cat
                    if chosen_cat == "ticket" and draft.get("provider") == "custom":
                        draft["provider"] = "jira"
                    elif chosen_cat in ("pull_request", "issue") and draft.get("provider") == "custom":
                        draft["provider"] = "github"

            elif field_key == "provider":
                prov_opts = [{"value": k, "label": lbl} for k, lbl in KNOWN_RESOURCE_PROVIDERS]
                chosen_prov = prompt_fzf_dropdown(
                    fzf_bin,
                    prov_opts,
                    prompt="Resource Provider > ",
                    header="Select provider or type a custom provider name ([Enter] Confirm, [Esc] Cancel):",
                    current_value=draft.get("provider") or "custom",
                    allow_custom=True,
                )
                if chosen_prov is not None and chosen_prov != "":
                    draft["provider"] = chosen_prov

            elif field_key == "status":
                status_opts = query_integration_field_options(
                    "resource.status",
                    paths,
                    cfg,
                    task=task,
                    resource=draft,
                    category=draft.get("category"),
                    provider=draft.get("provider"),
                )
                chosen_st = prompt_fzf_dropdown(
                    fzf_bin,
                    status_opts,
                    prompt=f"Status Badge ({draft.get('provider') or draft.get('category')}) > ",
                    header="Select predefined status from integration or type custom status ([Enter] Confirm, [Esc] Cancel):",
                    current_value=draft.get("status") or "",
                    allow_custom=True,
                    allow_clear=True,
                )
                if chosen_st is not None:
                    draft["status"] = chosen_st

            elif field_key == "summary":
                new_sum = prompt_inline_text("Resource Summary", current_value=draft.get("summary") or "", allow_clear=True)
                if new_sum is not None:
                    draft["summary"] = new_sum

            elif field_key == "url":
                new_url = prompt_inline_text("Resource URL", current_value=draft.get("url") or "", allow_clear=True)
                if new_url is not None:
                    draft["url"] = new_url

            elif field_key == "sync_branch":
                draft["sync_branch"] = not bool(draft.get("sync_branch"))


def _recompute_task_draft_id_and_branch(draft: dict[str, Any], mode: str) -> None:
    if mode != "create":
        return
    jk = (draft.get("jira_ticket") or "").strip()
    title = (draft.get("title") or "").strip()
    if not draft.get("custom_id"):
        if jk and title and title != "Untitled Task":
            clean_title = title[len(jk):].strip(" -:") if title.upper().startswith(jk.upper()) else title
            draft["id"] = slugify(f"{jk}-{slugify(clean_title, 24)}", 48)
        elif jk:
            draft["id"] = slugify(jk, 48)
        elif title and title != "Untitled Task":
            draft["id"] = slugify(title, 36)
        else:
            draft["id"] = ""

    if not draft.get("custom_branch"):
        comp_id = draft.get("id")
        if not comp_id:
            rand_suffix = uuid.uuid4().hex[:4]
            comp_id = f"task-{rand_suffix}"
        draft["default_branch"] = f"feat/{comp_id}" if jk else comp_id


def _format_task_form_rows(draft: dict[str, Any], mode: str) -> list[str]:
    title = draft.get("title") or ""
    st = (draft.get("status") or "in_progress").lower()
    st_icon = TASK_STATUS_ICONS.get(st, "🚧")
    jk_disp = draft.get("jira_ticket_display") or draft.get("jira_ticket") or ""
    pr_links = draft.get("pr_links") or []
    repos = draft.get("repos") or []
    def_branch = draft.get("default_branch") or ""
    repo_branches = draft.get("repo_branches") or {}
    brief = (draft.get("brief") or "").replace("\t", " ").replace("\n", " ")

    rows = [
        f"title\t📌 Task Title           : {title or '(click to enter title — or pick Jira Ticket below to auto-fill)'}",
        f"status\t🚦 Task Status          : {st_icon} {st.upper()}  [dropdown]",
        f"jira_ticket\t🎫 Jira Ticket          : {jk_disp or '(pick from My Jira Tickets / Open Jira in Browser...)'}  [picker]",
        f"pr_links\t🔀 GitHub PR / Links    : {', '.join(pr_links) if pr_links else '(pick from Open GitHub PRs / add URL...)'}  [picker]",
        f"repos\t📦 Repositories         : {', '.join(repos) if repos else '(none — click to multi-select repos)'}  [multi-select]",
        f"default_branch\t🌿 Default Branch       : {def_branch or '(auto)'}  [dropdown]",
    ]
    for r_name in repos:
        rb = repo_branches.get(r_name) or def_branch or f"feat/{draft.get('id') or 'task'}"
        rows.append(f"repo_branch:{r_name}\t  ↳ 🌿 Branch [{r_name}] : {rb}  [branch dropdown]")

    rows.append(f"brief\t📝 Technical Brief      : {(brief[:64] + '…') if len(brief) > 64 else (brief or '(none)')}")
    if mode == "create":
        tid_val = draft.get("id") or "(auto-generated from Ticket + Title)"
        rows.append(f"id\t🆔 Task ID              : {tid_val}")

    rows.append("open_jira\t🌐 Open Jira in Browser : Check / search your assigned tickets in Jira")
    save_label = "✅ Create Task & Provision Workspace" if mode == "create" else "✅ Save Task Changes"
    rows.append(f"_save_\t{save_label}  (or press [Ctrl-S])")
    rows.append("_cancel_\t❌ Cancel  (or press [Esc])")
    return rows


def interactive_task_form(
    paths: TaskPaths,
    cfg: dict[str, Any],
    task_id: str | None = None,
    initial_args: argparse.Namespace | None = None,
    no_herdr: bool = False,
) -> int:
    """
    Interactive field-navigator form for creating a new task (`task_id=None`)
    or editing an existing task (`task_id='<id>'`).
    Lets the user navigate to any field, open `fzf` dropdowns for Status, Repositories,
    Git Branches, Jira Tickets (with live Jira issue search & browser redirect), and GitHub PRs.
    """
    existing_task = load_task(paths, task_id) if task_id else None
    if task_id and not existing_task:
        print(f"Error: task '{task_id}' not found.", file=sys.stderr)
        return 1

    mode = "edit" if existing_task else "create"
    if existing_task:
        existing_tickets = [
            r for r in existing_task.get("resources", []) if r.get("category") == "ticket"
        ]
        first_tk = existing_tickets[0] if existing_tickets else None
        existing_prs = [
            r.get("ref") or r.get("url") or ""
            for r in existing_task.get("resources", [])
            if r.get("category") != "ticket" and (r.get("ref") or r.get("url"))
        ]
        wts = existing_task.get("worktrees") or []
        repos_init = [w["repo"] for w in wts if w.get("repo")]
        rb_init = {w["repo"]: w.get("branch") or "" for w in wts if w.get("repo")}

        draft: dict[str, Any] = {
            "id": existing_task["id"],
            "title": existing_task.get("title") or "",
            "status": existing_task.get("status") or "in_progress",
            "jira_ticket": (first_tk.get("ref") if first_tk else "") or "",
            "jira_ticket_display": (first_tk.get("label") if first_tk else "") or "",
            "pr_links": existing_prs,
            "repos": repos_init,
            "default_branch": existing_task.get("default_branch") or "",
            "repo_branches": rb_init,
            "brief": existing_task.get("brief") or "",
            "custom_id": True,
            "custom_branch": True,
            "enrichment_messages": [],
        }
    else:
        init_repos: list[str] = []
        if initial_args and getattr(initial_args, "repos", None):
            init_repos.extend([r.strip() for r in initial_args.repos.split(",") if r.strip()])
        if initial_args and getattr(initial_args, "repo_list", None):
            for rl in initial_args.repo_list:
                init_repos.extend([r.strip() for r in rl.split(",") if r.strip() and r.strip() not in init_repos])

        init_links = list(getattr(initial_args, "link", None) or []) if initial_args else []
        init_id = getattr(initial_args, "id", None) if initial_args else None
        init_branch = getattr(initial_args, "branch", None) if initial_args else None

        draft = {
            "id": init_id or "",
            "title": (getattr(initial_args, "title", None) if initial_args else None) or "",
            "status": (getattr(initial_args, "task_status", None) if initial_args else None) or "in_progress",
            "jira_ticket": "",
            "jira_ticket_display": "",
            "pr_links": init_links,
            "repos": init_repos,
            "default_branch": init_branch or "",
            "repo_branches": {},
            "brief": (getattr(initial_args, "brief", None) if initial_args else None) or "",
            "custom_id": bool(init_id),
            "custom_branch": bool(init_branch),
            "enrichment_messages": [],
        }
        _recompute_task_draft_id_and_branch(draft, mode)

    original = json.loads(json.dumps(draft))
    fzf_bin = resolve_bin("fzf", cfg, "fzf_bin")
    self_bin = f"{shlex.quote(sys.executable)} {shlex.quote(os.path.abspath(__file__))}"

    with tempfile.TemporaryDirectory(prefix="herdr_task_form_") as tmp_dir:
        state_file = Path(tmp_dir) / "form_state.json"

        while True:
            state_payload = {
                "form_type": "task",
                "mode": mode,
                "task_id": task_id or draft.get("id") or "new",
                "draft": draft,
                "original": original,
            }
            state_file.write_text(json.dumps(state_payload, ensure_ascii=False), encoding="utf-8")
            q_sfile = shlex.quote(str(state_file))

            rows = _format_task_form_rows(draft, mode)
            hdr = (
                "⚡ Create New Task  |  [Enter] Edit Field  [Ctrl-S] Create Task  [Ctrl-O] Open Jira  [Esc] Cancel"
                if mode == "create"
                else f"✏️  Edit Task '{task_id}'  |  [Enter] Edit Field  [Ctrl-S] Save Changes  [Ctrl-O] Open Jira  [Esc] Cancel"
            )

            cmd = [
                fzf_bin,
                "--ansi",
                "--delimiter=\t",
                "--with-nth=2",
                "--expect=ctrl-s,ctrl-o",
                "--header",
                hdr,
                "--prompt",
                f"{'Create Task' if mode == 'create' else f'Edit Task ({task_id})'} > ",
                "--preview",
                f"{self_bin} _popup-action preview-form {q_sfile} {{1}}",
                "--preview-window",
                "down:58%:wrap",
            ]

            res = subprocess.run(cmd, input="\n".join(rows), capture_output=True, text=True, check=False)
            if res.returncode != 0 or not res.stdout.strip():
                return 0

            out_lines = res.stdout.splitlines()
            expect_key = out_lines[0].strip() if len(out_lines) >= 1 else ""
            sel_line = out_lines[1].strip() if len(out_lines) >= 2 else ""
            field_key = sel_line.split("\t", 1)[0].strip() if sel_line else ""

            if expect_key == "ctrl-o" or field_key == "open_jira":
                jk = (draft.get("jira_ticket") or "").strip()
                base_browse = str(cfg.get("jira_base_url") or "").strip().rstrip("/")
                if jk and base_browse and "your-org.atlassian.net" not in base_browse:
                    if not base_browse.endswith("/browse"):
                        base_browse = f"{base_browse}/browse"
                    open_url_target(f"{base_browse}/{jk}")
                else:
                    default_jira = _resolve_default_jira_browse_url(cfg)
                    if default_jira:
                        open_url_target(default_jira)
                continue

            if expect_key == "ctrl-s" or field_key == "_save_":
                try:
                    rc = _submit_interactive_task_form(draft, original, mode, task_id, paths, cfg, no_herdr=no_herdr)
                    if rc == 0:
                        return 0
                except Exception as e:
                    prompt_inline_text(
                        f"⚠️ Error saving task: {e}\nPress Enter to return to form",
                        current_value="",
                        allow_clear=True,
                    )
                continue

            if field_key == "_cancel_" or not field_key:
                return 0

            if field_key == "title":
                new_t = prompt_inline_text("Task Title", current_value=draft.get("title") or "", allow_clear=False)
                if new_t is not None:
                    draft["title"] = new_t
                    _recompute_task_draft_id_and_branch(draft, mode)

            elif field_key == "status":
                allowed_statuses = VALID_TASK_STATUSES if mode == "edit" else VALID_TASK_STATUSES[:4]
                st_opts = [
                    {
                        "value": st,
                        "label": f"{TASK_STATUS_ICONS.get(st, '•')} {st.upper()}",
                    }
                    for st in allowed_statuses
                ]
                chosen_st = prompt_fzf_dropdown(
                    fzf_bin,
                    st_opts,
                    prompt="Task Status > ",
                    header="Select task lifecycle status (triggers modular automations e.g. Jira transition on save):",
                    current_value=draft.get("status") or "in_progress",
                    allow_custom=False,
                )
                if chosen_st:
                    draft["status"] = chosen_st

            elif field_key == "jira_ticket":
                chosen_jk, cand_patch = prompt_integration_candidate(
                    fzf_bin,
                    "ticket",
                    paths,
                    cfg,
                    prompt="Jira Ticket > ",
                    header="[Enter] Select Assigned Ticket, Open Jira in Browser, or Type Key (e.g. PROJ-123)  |  [Ctrl-O] Open Jira",
                    current_value=draft.get("jira_ticket") or "",
                    task=existing_task,
                    repos=draft.get("repos"),
                    allow_clear=True,
                )
                if chosen_jk is not None:
                    if chosen_jk == "":
                        draft["jira_ticket"] = ""
                        draft["jira_ticket_display"] = ""
                        _recompute_task_draft_id_and_branch(draft, mode)
                    else:
                        temp_res: dict[str, Any] = {"ref": chosen_jk}
                        enr_msgs = apply_resource_target_to_draft(
                            temp_res,
                            chosen_jk,
                            cfg,
                            paths,
                            task=existing_task,
                            candidate_patch=cand_patch,
                        )
                        draft["jira_ticket"] = temp_res.get("ref") or chosen_jk
                        draft["jira_ticket_display"] = temp_res.get("label") or draft["jira_ticket"]
                        draft.setdefault("enrichment_messages", []).extend(enr_msgs)

                        meta = temp_res.get("metadata") or {}
                        j_title = meta.get("jira_title") or ""
                        if not j_title and temp_res.get("label") and ":" in temp_res["label"]:
                            j_title = temp_res["label"].split(":", 1)[1].strip()
                        if j_title and (not draft.get("title") or draft.get("title") == "Untitled Task"):
                            draft["title"] = f"{draft['jira_ticket']} {j_title}"
                        if temp_res.get("summary") and not draft.get("brief"):
                            draft["brief"] = temp_res["summary"]
                        _recompute_task_draft_id_and_branch(draft, mode)

            elif field_key == "pr_links":
                chosen_pr, cand_patch = prompt_integration_candidate(
                    fzf_bin,
                    "pull_request",
                    paths,
                    cfg,
                    prompt="GitHub PR or Resource Link > ",
                    header="[Enter] Select Open PR (`gh pr list`), Open GitHub in Browser, or Type URL/repo#123  |  [Ctrl-O] Browser",
                    current_value="",
                    task=existing_task,
                    repos=draft.get("repos"),
                    allow_clear=True,
                )
                if chosen_pr is not None:
                    if chosen_pr == "":
                        draft["pr_links"] = []
                    else:
                        temp_res = {"ref": chosen_pr}
                        enr_msgs = apply_resource_target_to_draft(
                            temp_res,
                            chosen_pr,
                            cfg,
                            paths,
                            task=existing_task,
                            candidate_patch=cand_patch,
                        )
                        link_val = temp_res.get("url") or temp_res.get("ref") or chosen_pr
                        if link_val not in draft["pr_links"]:
                            draft["pr_links"].append(link_val)
                        draft.setdefault("enrichment_messages", []).extend(enr_msgs)

                        meta = temp_res.get("metadata") or {}
                        pr_repo = meta.get("repo")
                        pr_branch = meta.get("branch")
                        if pr_repo:
                            try:
                                r_short, _ = resolve_repo_path(pr_repo, cfg)
                                if r_short not in draft["repos"]:
                                    draft["repos"].append(r_short)
                                if pr_branch:
                                    draft["repo_branches"][r_short] = pr_branch
                                    if not draft.get("custom_branch"):
                                        draft["default_branch"] = pr_branch
                            except Exception:
                                pass
                        if meta.get("pr_title") and (not draft.get("title") or draft.get("title") == "Untitled Task"):
                            draft["title"] = meta["pr_title"]
                        if meta.get("jira_key") and not draft.get("jira_ticket"):
                            draft["jira_ticket"] = meta["jira_key"]
                            draft["jira_ticket_display"] = meta["jira_key"]
                        _recompute_task_draft_id_and_branch(draft, mode)

            elif field_key == "repos":
                avail_repos = discover_available_repos(cfg)
                if avail_repos and sys.stdin.isatty():
                    cur_repos = set(draft.get("repos") or [])
                    repo_lines = [
                        f"{r}\t📦 {r}" + ("  ✨ (currently selected)" if r in cur_repos else "")
                        for r in avail_repos
                    ]
                    fzf_repo = subprocess.run(
                        [
                            fzf_bin,
                            "-m",
                            "--delimiter=\t",
                            "--with-nth=2",
                            "--prompt=Select Repositories ([Tab] multi-select) > ",
                            "--header=[Tab] Toggle repo selection   [Enter] Confirm selection   [Esc] Cancel",
                        ],
                        input="\n".join(repo_lines),
                        capture_output=True,
                        text=True,
                        check=False,
                    )
                    if fzf_repo.returncode == 0 and fzf_repo.stdout.strip():
                        chosen_repos = [
                            ln.split("\t", 1)[0].strip()
                            for ln in fzf_repo.stdout.strip().splitlines()
                            if ln.strip()
                        ]
                        if mode == "edit":
                            # Keep existing attached repos and append any newly selected ones
                            merged = list(draft.get("repos") or [])
                            for cr in chosen_repos:
                                if cr not in merged:
                                    merged.append(cr)
                            draft["repos"] = merged
                        else:
                            draft["repos"] = chosen_repos
                        for r_name in draft["repos"]:
                            draft["repo_branches"].setdefault(
                                r_name,
                                draft.get("default_branch") or f"feat/{draft.get('id') or 'task'}",
                            )
                else:
                    raw_r = prompt_inline_text(
                        "Repositories (comma-separated)",
                        current_value=",".join(draft.get("repos") or []),
                        allow_clear=True,
                    )
                    if raw_r is not None:
                        draft["repos"] = [r.strip() for r in raw_r.split(",") if r.strip()]

            elif field_key == "default_branch":
                br_opts = query_integration_field_options(
                    "task.branch",
                    paths,
                    cfg,
                    task=existing_task,
                    repos=draft.get("repos"),
                    task_id=draft.get("id"),
                    current_branch=draft.get("default_branch"),
                )
                chosen_br = prompt_fzf_dropdown(
                    fzf_bin,
                    br_opts,
                    prompt="Default Git Branch > ",
                    header="Select a local/remote branch or type a new branch name ([Enter] Confirm, [Esc] Cancel):",
                    current_value=draft.get("default_branch") or "",
                    allow_custom=True,
                )
                if chosen_br:
                    old_def = draft.get("default_branch")
                    draft["default_branch"] = chosen_br
                    draft["custom_branch"] = True
                    for r_name in draft.get("repos") or []:
                        if draft["repo_branches"].get(r_name) in (None, "", old_def):
                            draft["repo_branches"][r_name] = chosen_br

            elif field_key.startswith("repo_branch:"):
                target_repo = field_key.split(":", 1)[1]
                cur_rb = (draft.get("repo_branches") or {}).get(target_repo) or draft.get("default_branch") or ""
                br_opts = query_integration_field_options(
                    "worktree.branch",
                    paths,
                    cfg,
                    task=existing_task,
                    repo=target_repo,
                    task_id=draft.get("id"),
                    current_branch=cur_rb,
                )
                chosen_rb = prompt_fzf_dropdown(
                    fzf_bin,
                    br_opts,
                    prompt=f"Git Branch [{target_repo}] > ",
                    header=f"Select local/remote branch for '{target_repo}' or type a new branch name:",
                    current_value=cur_rb,
                    allow_custom=True,
                )
                if chosen_rb:
                    draft.setdefault("repo_branches", {})[target_repo] = chosen_rb

            elif field_key == "brief":
                new_b = prompt_inline_text("Technical Brief", current_value=draft.get("brief") or "", allow_clear=True)
                if new_b is not None:
                    draft["brief"] = new_b

            elif field_key == "id" and mode == "create":
                new_id = prompt_inline_text("Task ID Slug", current_value=draft.get("id") or "", allow_clear=True)
                if new_id is not None:
                    if new_id == "":
                        draft["custom_id"] = False
                        _recompute_task_draft_id_and_branch(draft, mode)
                    else:
                        draft["id"] = slugify(new_id, 48)
                        draft["custom_id"] = True


def _submit_interactive_task_form(
    draft: dict[str, Any],
    original: dict[str, Any],
    mode: str,
    task_id: str | None,
    paths: TaskPaths,
    cfg: dict[str, Any],
    no_herdr: bool = False,
) -> int:
    if mode == "create":
        links: list[str] = []
        if draft.get("jira_ticket"):
            links.append(draft["jira_ticket"])
        for pl in draft.get("pr_links") or []:
            if pl and pl not in links:
                links.append(pl)

        title = (draft.get("title") or "").strip() or "Untitled Task"
        repos_list = list(draft.get("repos") or [])
        repo_branches = draft.get("repo_branches") or {}
        def_branch = (draft.get("default_branch") or "").strip() or None

        try:
            rc = cmd_create(
                argparse.Namespace(
                    id=draft.get("id") or None,
                    title=title,
                    brief=draft.get("brief") or None,
                    task_status=draft.get("status") or "in_progress",
                    repos=",".join(repos_list) if repos_list else None,
                    repo_list=None,
                    branch=def_branch,
                    link=links or None,
                    label=None,
                    status=None,
                    summary=None,
                    spec_stdin=False,
                    focus=True,
                    no_herdr=no_herdr,
                    json=False,
                    interactive=False,
                ),
                paths,
                cfg,
            )
        except Exception as e:
            prompt_inline_text(
                f"⚠️ Error creating task: {e}\nPress Enter to return to form",
                current_value="",
                allow_clear=True,
            )
            return 1

        if rc != 0:
            prompt_inline_text(
                "⚠️ Task creation failed (check error messages above).\nPress Enter to return to form",
                current_value="",
                allow_clear=True,
            )
            return rc

        # If per-repo branch overrides differ from default_branch, apply them
        created_id = resolve_current_task_id(paths, draft.get("id"))
        if created_id and repo_branches:
            rb_Pairs = [
                f"{r}:{b}"
                for r, b in repo_branches.items()
                if b and b != def_branch
            ]
            if rb_Pairs:
                cmd_update(
                    argparse.Namespace(
                        task_id=created_id,
                        task=created_id,
                        title=None,
                        brief=None,
                        status=None,
                        branch=None,
                        repo_branch=rb_Pairs,
                        sync_pr_branches=False,
                        force=False,
                        no_herdr=no_herdr,
                        json=False,
                        interactive=False,
                    ),
                    paths,
                    cfg,
                )
        return 0

    # Edit mode
    assert task_id is not None
    orig_repos = set(original.get("repos") or [])
    new_repos = [r for r in (draft.get("repos") or []) if r not in orig_repos]
    for nr in new_repos:
        target_b = (draft.get("repo_branches") or {}).get(nr) or draft.get("default_branch") or None
        cmd_worktree_add(
            argparse.Namespace(
                task=task_id,
                repo=nr,
                branch=target_b,
                label=None,
                focus=False,
                no_herdr=no_herdr,
                json=False,
            ),
            paths,
            cfg,
        )

    # Link any newly added Jira ticket or PR links
    if draft.get("jira_ticket") and draft.get("jira_ticket") != original.get("jira_ticket"):
        cmd_link(
            argparse.Namespace(
                target=draft["jira_ticket"],
                task=task_id,
                label=None,
                status=None,
                summary=None,
                category="ticket",
                provider="jira",
                added_by=None,
                metadata=None,
                sync_branch=False,
                no_herdr=no_herdr,
                json=False,
                interactive=False,
            ),
            paths,
            cfg,
        )

    orig_prs = set(original.get("pr_links") or [])
    for pl in draft.get("pr_links") or []:
        if pl and pl not in orig_prs:
            cmd_link(
                argparse.Namespace(
                    target=pl,
                    task=task_id,
                    label=None,
                    status=None,
                    summary=None,
                    category=None,
                    provider=None,
                    added_by=None,
                    metadata=None,
                    sync_branch=False,
                    no_herdr=no_herdr,
                    json=False,
                    interactive=False,
                ),
                paths,
                cfg,
            )

    orig_rb = original.get("repo_branches") or {}
    cur_rb = draft.get("repo_branches") or {}
    rb_updates = [
        f"{r}:{b}"
        for r, b in cur_rb.items()
        if b and b != orig_rb.get(r)
    ]

    new_title = draft.get("title") if draft.get("title") != original.get("title") else None
    new_brief: str | None = None
    if draft.get("brief") != original.get("brief"):
        new_brief = "-" if not draft.get("brief") else draft["brief"]
    new_status = draft.get("status") if draft.get("status") != original.get("status") else None
    new_def_branch = draft.get("default_branch") if draft.get("default_branch") != original.get("default_branch") else None

    return cmd_update(
        argparse.Namespace(
            task_id=task_id,
            task=task_id,
            title=new_title,
            brief=new_brief,
            status=new_status,
            branch=new_def_branch,
            repo_branch=rb_updates,
            sync_pr_branches=False,
            force=False,
            no_herdr=no_herdr,
            json=False,
            interactive=False,
        ),
        paths,
        cfg,
    )


def manage_task_resources(tid: str, paths: TaskPaths, cfg: dict[str, Any]) -> int:
    if not is_valid_task_id(tid):
        return 1
    fzf_bin = resolve_bin("fzf", cfg, "fzf_bin")
    self_bin = f"{shlex.quote(sys.executable)} {shlex.quote(os.path.abspath(__file__))}"
    q_tid = shlex.quote(tid)

    while True:
        task = load_task(paths, tid)
        if not task:
            return 0

        lines = format_fzf_resource_lines(task)
        header = (
            f"Task: {task.get('title', tid)}  |  "
            "[Enter] Open URL  [Ctrl-S] Status  [Ctrl-R] Sync  [Ctrl-P] Pilot  [Ctrl-N] +Add  [Ctrl-E] Edit  [Ctrl-D] Del  [Esc] Back"
        )
        fzf_cmd = [
            fzf_bin,
            "--ansi",
            "--delimiter=\t",
            "--with-nth=2",
            "--header", header,
            "--prompt", f"Resources ({tid}) > ",
            "--preview", f"{self_bin} _popup-action preview-resource {q_tid} {{1}}",
            "--preview-window", "down:64%:wrap",
            "--bind", f"ctrl-s:execute({self_bin} _popup-action set-status {q_tid})+reload({self_bin} _popup-action list-resources {q_tid})",
            "--bind", f"ctrl-r:execute({self_bin} _popup-action sync-task {q_tid})+reload({self_bin} _popup-action list-resources {q_tid})",
            "--bind", f"ctrl-p:execute({self_bin} _popup-action task-pilot {q_tid})+reload({self_bin} _popup-action list-resources {q_tid})",
            "--bind", f"ctrl-n:execute({self_bin} _popup-action add-resource {q_tid})+reload({self_bin} _popup-action list-resources {q_tid})",
            "--bind", f"ctrl-a:execute({self_bin} _popup-action add-resource {q_tid})+reload({self_bin} _popup-action list-resources {q_tid})",
            "--bind", f"ctrl-e:execute({self_bin} _popup-action edit-resource {q_tid} {{1}})+reload({self_bin} _popup-action list-resources {q_tid})",
            "--bind", f"ctrl-d:execute({self_bin} _popup-action delete-resource {q_tid} {{1}})+reload({self_bin} _popup-action list-resources {q_tid})",
            "--bind", f"ctrl-x:execute({self_bin} _popup-action delete-resource {q_tid} {{1}})+reload({self_bin} _popup-action list-resources {q_tid})",
        ]

        res = subprocess.run(fzf_cmd, input="\n".join(lines), text=True, capture_output=True, check=False)
        if res.returncode != 0 or not res.stdout.strip():
            return 0

        chosen_res_id = res.stdout.strip().splitlines()[0].split("\t", 1)[0].strip()
        if chosen_res_id == "_add_":
            cmd_popup_action(argparse.Namespace(action="add-resource", task_id=tid, resource_id=None), paths, cfg)
            continue
        if chosen_res_id == "_pilot_":
            cmd_popup_action(argparse.Namespace(action="task-pilot", task_id=tid, resource_id=None), paths, cfg)
            continue

        cmd_popup_action(argparse.Namespace(action="open-resource", task_id=tid, resource_id=chosen_res_id), paths, cfg)


def cmd_popup_action(args: argparse.Namespace, paths: TaskPaths, cfg: dict[str, Any]) -> int:
    action = args.action
    tid = args.task_id
    res_id = getattr(args, "resource_id", None)
    fzf_bin = resolve_bin("fzf", cfg, "fzf_bin")

    if action == "resources":
        return manage_task_resources(tid, paths, cfg)

    if action == "list-resources":
        task = load_task(paths, tid)
        if not task:
            return 1
        for line in format_fzf_resource_lines(task):
            print(line)
        return 0

    if action == "preview-resource":
        task = load_task(paths, tid)
        if not task:
            print(f"Task '{tid}' not found.")
            return 1
        print(format_resource_preview(task, res_id or "_add_", color=True))
        return 0

    if action == "open-resource":
        if res_id == "_pilot_":
            return cmd_popup_action(argparse.Namespace(action="task-pilot", task_id=tid, resource_id=None), paths, cfg)
        if res_id == "_add_" or not res_id:
            return cmd_popup_action(argparse.Namespace(action="add-resource", task_id=tid, resource_id=None), paths, cfg)
        task = load_task(paths, tid)
        if not task:
            return 1
        for r in task.get("resources", []):
            if r.get("id") == res_id or r.get("ref") == res_id:
                target_url = r.get("url") or r.get("ref") or ""
                if target_url and open_url_target(target_url):
                    print(f"Opened: {target_url}")
                    return 0
                return 1
        return 1

    if action == "preview-form":
        state_file = Path(tid)
        if state_file.exists():
            try:
                st_data = json.loads(state_file.read_text(encoding="utf-8"))
                print(format_form_preview(st_data, res_id or "", color=True))
                return 0
            except Exception as e:
                print(f"Error previewing form: {e}")
                return 1
        return 1

    if action == "preview-candidate":
        pfile = Path(tid)
        if pfile.exists():
            try:
                pdata = json.loads(pfile.read_text(encoding="utf-8"))
                print(pdata.get(res_id or "", "No preview available."))
                return 0
            except Exception:
                pass
        return 1

    if action == "edit-resource":
        if res_id == "_pilot_":
            return cmd_popup_action(argparse.Namespace(action="task-pilot", task_id=tid, resource_id=None), paths, cfg)
        if res_id == "_add_" or not res_id:
            return cmd_popup_action(argparse.Namespace(action="add-resource", task_id=tid, resource_id=None), paths, cfg)
        return interactive_resource_form(tid, paths, cfg, resource_id=res_id)

    if action == "delete-resource":
        if res_id in ("_add_", "_pilot_") or not res_id:
            return 0
        task = load_task(paths, tid)
        if not task:
            return 1
        target_res = next(
            (r for r in task.get("resources", []) if r.get("id") == res_id or r.get("ref") == res_id),
            None,
        )
        if not target_res:
            return 0
        print(
            f"\nDelete resource '{target_res.get('ref')} — {target_res.get('label', '')}' from task '{tid}'? [y/N]: ",
            end="",
            flush=True,
        )
        if sys.stdin.readline().strip().lower() not in ("y", "yes"):
            return 0
        return cmd_unlink(argparse.Namespace(target=target_res["id"], task=tid, no_herdr=False), paths, cfg)

    if action == "cleanup":
        print(f"Clean up task '{tid}' (closes Herdr workspace, removes worktrees, archives task)? [y/N]: ", end="", flush=True)
        if sys.stdin.readline().strip().lower() not in ("y", "yes"):
            return 0
        rc = cmd_cleanup(
            argparse.Namespace(task_id=tid, force=False, delete_branches=False, no_herdr=False, json=False),
            paths,
            cfg,
        )
        if rc != 0:
            print("\nForce cleanup despite uncommitted changes? [y/N]: ", end="", flush=True)
            if sys.stdin.readline().strip().lower() in ("y", "yes"):
                cmd_cleanup(
                    argparse.Namespace(task_id=tid, force=True, delete_branches=False, no_herdr=False, json=False),
                    paths,
                    cfg,
                )
            else:
                print("Cleanup aborted. Press Enter to return...")
                sys.stdin.readline()
        return 0

    if action == "add-repo":
        rc = cmd_add(
            argparse.Namespace(repo=None, branch=None, task=tid, focus=True, no_herdr=False, json=False),
            paths,
            cfg,
        )
        if rc != 0:
            print("\nError adding repository worktree(s). Press Enter to continue...")
            sys.stdin.readline()
        return 0

    if action == "add-resource":
        return interactive_resource_form(tid, paths, cfg, resource_id=None)

    if action == "set-status":
        task = load_task(paths, tid)
        if not task:
            return 1
        cur_st = (task.get("status") or "in_progress").lower()
        status_items = [
            f"{st}\t{TASK_STATUS_ICONS.get(st, '•')} {st.upper()}"
            + ("  (current)" if st == cur_st else "")
            for st in ("todo", "in_progress", "in_review", "done")
        ]
        res = subprocess.run(
            [
                fzf_bin,
                "--delimiter=\t",
                "--with-nth=2",
                f"--prompt=Task Status ({tid}) > ",
                f"--header=Transition '{task.get('title', tid)}' (runs lifecycle automations e.g. Jira status sync):",
            ],
            input="\n".join(status_items),
            capture_output=True,
            text=True,
            check=False,
        )
        if res.returncode != 0 or not res.stdout.strip():
            return 0
        chosen_st = res.stdout.strip().split("\t", 1)[0].strip()
        return cmd_update(
            argparse.Namespace(
                task_id=tid,
                task=tid,
                title=None,
                brief=None,
                status=chosen_st,
                branch=None,
                repo_branch=None,
                sync_pr_branches=False,
                no_herdr=False,
                json=False,
            ),
            paths,
            cfg,
        )

    if action == "sync-task":
        return cmd_sync(
            argparse.Namespace(task_id=tid, task=tid, no_herdr=False, json=False),
            paths,
            cfg,
        )

    if action == "pilot":
        tasks_count = len(list_all_tasks(paths))
        header_text = (
            "No active tasks yet. Choose how to initialize your new task (or Esc to cancel):"
            if tasks_count == 0
            else "Choose how to initialize your new task (or Esc to cancel):"
        )
        choice, pilot_cmd_list = _select_pilot_choice_and_cmd(
            cfg,
            fzf_bin,
            prompt="Create Task > ",
            header=header_text,
            include_quick=True,
        )
        if not choice:
            return 0

        if choice == "quick":
            return interactive_task_form(paths, cfg, task_id=None)

        pilot_env = os.environ.copy()
        pilot_env.pop("HERDR_TASK_ID", None)
        pilot_env.pop("HERDR_WORKSPACE_ID", None)
        pilot_env["HERDR_PILOT_MODE"] = "new_task"

        print(f"\n--- Launching Temporary Pilot Agent ({' '.join(pilot_cmd_list)}) ---")
        print("Tell the Pilot what task to initialize (e.g. 'Setup task for CHRON-452 on chronos-api').")
        print("When done, type 'exit' or press Ctrl-C to return to Mission Control.\n")
        subprocess.run(pilot_cmd_list, env=pilot_env, cwd=os.path.expanduser("~"), check=False)
        return 0

    if action == "task-pilot":
        task = load_task(paths, tid)
        if not task:
            print(f"Task '{tid}' not found.")
            return 1

        task_title = task.get("title", tid)
        choice, pilot_cmd_list = _select_pilot_choice_and_cmd(
            cfg,
            fzf_bin,
            prompt=f"Task Pilot ({tid}) > ",
            header=f"Select AI Pilot model to manage existing task '{tid} — {task_title}' (or Esc to cancel):",
            include_quick=False,
        )
        if not choice:
            return 0

        pilot_env = os.environ.copy()
        pilot_env["HERDR_TASK_ID"] = tid
        pilot_env["HERDR_PILOT_MODE"] = "existing_task"
        pilot_env.pop("HERDR_WORKSPACE_ID", None)

        pilot_cwd = os.path.expanduser("~")
        for wt in task.get("worktrees", []):
            wt_p = wt.get("worktree_path") or ""
            if wt_p and os.path.isdir(wt_p):
                pilot_cwd = wt_p
                break

        print(f"\n--- 🤖 Task Pilot Agent on '{tid}' ({task_title}) ---")
        print(f"Environment: HERDR_TASK_ID={tid}  HERDR_PILOT_MODE=existing_task  CWD={pilot_cwd}")
        print("Ask the Pilot to link PRs/tickets, add repo worktrees, fetch Jira/GitHub context, or add notes.")
        print("When done, type 'exit' or press Ctrl-C to return to Mission Control.\n")
        subprocess.run(pilot_cmd_list, env=pilot_env, cwd=pilot_cwd, check=False)
        return 0

    if action == "edit-task":
        return interactive_task_form(paths, cfg, task_id=tid)

    return 0


def cmd_popup(args: argparse.Namespace, paths: TaskPaths, cfg: dict[str, Any]) -> int:
    fzf_bin = resolve_bin("fzf", cfg, "fzf_bin")
    self_bin = f"{shlex.quote(sys.executable)} {shlex.quote(os.path.abspath(__file__))}"

    tasks = list_all_tasks(paths)
    if not tasks:
        return cmd_popup_action(
            argparse.Namespace(action="pilot", task_id="_none_", resource_id=None),
            paths,
            cfg,
        )

    header = (
        "[Enter] Resources  [Ctrl-S] Status  [Ctrl-R] Sync  "
        "[Ctrl-P] Pilot  [Ctrl-E] Edit  [Ctrl-N] New  [Ctrl-A] +Repo  [Ctrl-X] Cleanup"
    )

    while True:
        tasks = list_all_tasks(paths)
        if not tasks:
            return 0
        lines = [format_fzf_task_line(t) for t in tasks]

        fzf_cmd = [
            fzf_bin,
            "--ansi",
            "--delimiter=\t",
            "--with-nth=1,2",
            "--header", header,
            "--expect", "ctrl-n",
            "--prompt", "Task Info & Resources > ",
            "--preview", f"{self_bin} status {{1}} --color",
            "--preview-window", "down:64%:wrap",
            "--bind", f"ctrl-s:execute({self_bin} _popup-action set-status {{1}})+reload({self_bin} list --fzf)",
            "--bind", f"ctrl-r:execute({self_bin} _popup-action sync-task {{1}})+reload({self_bin} list --fzf)",
            "--bind", f"ctrl-p:execute({self_bin} _popup-action task-pilot {{1}})+reload({self_bin} list --fzf)",
            "--bind", f"ctrl-e:execute({self_bin} _popup-action edit-task {{1}})+reload({self_bin} list --fzf)",
            "--bind", f"ctrl-a:execute({self_bin} _popup-action add-repo {{1}})+reload({self_bin} list --fzf)",
            "--bind", f"ctrl-x:execute({self_bin} _popup-action cleanup {{1}})+reload({self_bin} list --fzf)",
        ]

        res = subprocess.run(fzf_cmd, input="\n".join(lines), text=True, capture_output=True, check=False)
        if not res.stdout:
            return 0

        out_lines = res.stdout.splitlines()
        key = out_lines[0].strip() if out_lines else ""
        if key == "ctrl-n":
            cmd_popup_action(
                argparse.Namespace(action="pilot", task_id="_none_", resource_id=None),
                paths,
                cfg,
            )
            continue

        if res.returncode != 0 or len(out_lines) < 2:
            return 0

        selected_line = out_lines[1]
        chosen_tid = selected_line.split("\t", 1)[0].strip()
        if not chosen_tid:
            return 0

        manage_task_resources(chosen_tid, paths, cfg)


# ---------------------------------------------------------------------------
# Argument Parser
# ---------------------------------------------------------------------------

def build_parser() -> argparse.ArgumentParser:
    p = argparse.ArgumentParser(
        prog="herdr-task",
        description="Lightweight Task & Worktree Orchestrator for Multi-Repo Herdr Workspaces",
    )
    sub = p.add_subparsers(dest="subcommand")

    # create
    p_create = sub.add_parser("create", help="Create a multi-repo task and provision Herdr workspace/tabs")
    p_create.add_argument("-i", "--interactive", action="store_true", help="Launch interactive field-navigator task form")
    p_create.add_argument("--id", help="Explicit task ID slug (e.g. PLA-4350-rabbitmq)")
    p_create.add_argument("--title", help="Human-readable task title")
    p_create.add_argument("--brief", help="Concise technical brief")
    p_create.add_argument("--task-status", dest="task_status", choices=VALID_TASK_STATUSES, default=None, help="Initial task lifecycle status")
    p_create.add_argument("--repos", help="Comma-separated list of repository names or paths")
    p_create.add_argument("--repo", dest="repo_list", action="append", help="Repository name or path (repeatable)")
    p_create.add_argument("--branch", help="Git branch name across repositories")
    p_create.add_argument("--link", action="append", help="Resource URL or ticket key to link (repeatable)")
    p_create.add_argument("--label", help="Label for linked resource")
    p_create.add_argument("--status", help="Status badge for linked resource")
    p_create.add_argument("--summary", help="Distilled summary for linked resource")
    p_create.add_argument("--spec-stdin", action="store_true", help="Read full task creation spec as JSON from stdin")
    p_create.add_argument("--focus", action="store_true", help="Focus the newly created Herdr workspace")
    p_create.add_argument("--no-herdr", action="store_true", help="Skip Herdr socket calls")
    p_create.add_argument("--json", action="store_true", help="Output created task as JSON")

    # update / edit
    for name in ("update", "edit"):
        p_upd = sub.add_parser(name, help="Update task title, status, brief, default branch, or switch worktree branches")
        p_upd.add_argument("-i", "--interactive", action="store_true", help="Launch interactive field-navigator task form")
        p_upd.add_argument("task_id", nargs="?", help="Task ID (defaults to ambient task)")
        p_upd.add_argument("--task", help="Task ID (alternative flag)")
        p_upd.add_argument("--title", help="Update human-readable task title (also renames Herdr workspace)")
        p_upd.add_argument("--brief", help="Update technical brief (pass '-' to clear)")
        p_upd.add_argument("--status", help=f"Update task lifecycle status ({', '.join(VALID_TASK_STATUSES)}) and run automations")
        p_upd.add_argument("--branch", help="Update default_branch (and switch single-repo worktree)")
        p_upd.add_argument(
            "--repo-branch",
            dest="repo_branch",
            action="append",
            help="Switch a repo worktree to a specific branch: <repo>:<branch> (repeatable)",
        )
        p_upd.add_argument(
            "--sync-pr-branches",
            dest="sync_pr_branches",
            action="store_true",
            help="Automatically switch each attached repo worktree to match its linked GitHub PR branch",
        )
        p_upd.add_argument("--force", action="store_true", help="Force branch switch even if worktree has uncommitted changes")
        p_upd.add_argument("--no-herdr", action="store_true")
        p_upd.add_argument("--json", action="store_true")

    # sync
    p_sync_task = sub.add_parser("sync", help="Bidirectionally sync task & resource statuses (Jira, GitHub PRs)")
    p_sync_task.add_argument("task_id", nargs="?", help="Task ID (defaults to ambient task)")
    p_sync_task.add_argument("--task", help="Task ID (alternative flag)")
    p_sync_task.add_argument("--no-herdr", action="store_true")
    p_sync_task.add_argument("--json", action="store_true")

    # automations
    p_auto = sub.add_parser("automations", help="Inspect modular lifecycle automations")
    p_auto.add_argument("auto_action", nargs="?", default="list", choices=["list"], help="Automation subcommand")
    p_auto.add_argument("--json", action="store_true")

    # integrations
    p_integ = sub.add_parser("integrations", help="Inspect modular integrations, candidates, and options")
    p_integ.add_argument("integ_action", nargs="?", default="list", choices=["list", "candidates", "options"])
    p_integ.add_argument("target", nargs="?", help="Candidate kind (ticket, pull_request, resource) or field (resource.status, task.branch)")
    p_integ.add_argument("--task", help="Task ID")
    p_integ.add_argument("--category", help="Resource category")
    p_integ.add_argument("--provider", help="Resource provider")
    p_integ.add_argument("--repo", help="Repository name")
    p_integ.add_argument("--ref", help="Resource reference/key")
    p_integ.add_argument("--json", action="store_true")

    # current
    p_curr = sub.add_parser("current", help="Resolve active task ID from HERDR_TASK_ID, HERDR_WORKSPACE_ID, or PWD")
    p_curr.add_argument("--json", action="store_true")

    # list
    p_list = sub.add_parser("list", help="List tasks")
    p_list.add_argument("--all", action="store_true", help="Include archived tasks")
    p_list.add_argument("--fzf", action="store_true", help="Format output for fzf")
    p_list.add_argument("--json", action="store_true", help="Output JSON")

    # status / show
    for name in ("status", "show"):
        p_st = sub.add_parser(name, help="Show task status, worktrees, resources, summaries, and notes")
        p_st.add_argument("task_id", nargs="?", help="Task ID (defaults to ambient task)")
        p_st.add_argument("--color", action="store_true", help="ANSI color output")
        p_st.add_argument("--no-herdr", action="store_true")
        p_st.add_argument("--json", action="store_true", help="Output JSON")

    # focus / switch
    for name in ("focus", "switch"):
        p_foc = sub.add_parser(name, help="Focus task workspace/tab in Herdr (auto-reopening if closed)")
        p_foc.add_argument("task_id", nargs="?", help="Task ID (defaults to ambient task)")
        p_foc.add_argument("--repo", help="Focus specific repository tab")

    # link
    p_link = sub.add_parser("link", help="Link or update a resource (Jira, PR, Slack, Alert, Doc) on a task")
    p_link.add_argument("-i", "--interactive", action="store_true", help="Launch interactive field-navigator resource form")
    p_link.add_argument("target", nargs="?", default=None, help="URL, Jira key (PROJ-123), or GitHub shorthand (repo#123)")
    p_link.add_argument("--label", help="Short display label")
    p_link.add_argument("--status", help="Cached status badge (e.g. 'In Progress', 'OPEN')")
    p_link.add_argument("--summary", help="Distilled technical summary (avoids redundant MCP calls)")
    p_link.add_argument("--category", choices=["ticket", "pull_request", "issue", "conversation", "alert", "doc", "custom"])
    p_link.add_argument("--provider", help="Provider name (jira, github, slack, ...)")
    p_link.add_argument("--added-by", dest="added_by", help="Author/agent identifier")
    p_link.add_argument("--metadata", action="append", help="Extra key=value metadata")
    p_link.add_argument("--sync-branch", dest="sync_branch", action="store_true", help="Switch repo worktree to the linked PR's branch")
    p_link.add_argument("--task", help="Task ID (defaults to ambient task)")
    p_link.add_argument("--no-herdr", action="store_true")
    p_link.add_argument("--json", action="store_true")

    # unlink
    p_unlink = sub.add_parser("unlink", help="Remove a linked resource by ID, ref, or URL")
    p_unlink.add_argument("target", help="Resource ID, ref (e.g. CHRON-452), or URL")
    p_unlink.add_argument("--task", help="Task ID (defaults to ambient task)")
    p_unlink.add_argument("--no-herdr", action="store_true")

    # note
    p_note = sub.add_parser("note", help="Append a cross-repo handoff note to the task")
    p_note.add_argument("text", help="Handoff note text")
    p_note.add_argument("--author", help="Author identifier")
    p_note.add_argument("--task", help="Task ID (defaults to ambient task)")
    p_note.add_argument("--json", action="store_true")

    # add
    p_add = sub.add_parser("add", help="Add repository worktree(s) and Cockpit tab to the active task")
    p_add.add_argument("repo", nargs="?", help="Repository name or path (opens fzf autocomplete if omitted)")
    p_add.add_argument("--branch", help="Branch name (defaults to task default_branch)")
    p_add.add_argument("--task", help="Task ID (defaults to ambient task)")
    p_add.add_argument("--no-focus", dest="focus", action="store_false", default=True, help="Don't focus the new tab")
    p_add.add_argument("--no-herdr", action="store_true")
    p_add.add_argument("--json", action="store_true")

    # worktree (compatibility aliases)
    p_wt = sub.add_parser("worktree", help="Manage task git worktrees")
    wt_sub = p_wt.add_subparsers(dest="wt_subcommand")
    p_wt_add = wt_sub.add_parser("add", help="Add a repository worktree and Herdr tab to a task")
    p_wt_add.add_argument("--repo", required=True, help="Repository name or path")
    p_wt_add.add_argument("--label", help="Optional custom tab title")
    p_wt_add.add_argument("--branch", help="Branch name (defaults to task default_branch)")
    p_wt_add.add_argument("--task", help="Task ID (defaults to ambient task)")
    p_wt_add.add_argument("--focus", action="store_true")
    p_wt_add.add_argument("--no-herdr", action="store_true")
    p_wt_add.add_argument("--json", action="store_true")

    for wt_b_name in ("branch", "switch"):
        p_wt_br = wt_sub.add_parser(wt_b_name, help="Switch a registered repo worktree to another git branch")
        p_wt_br.add_argument("--repo", required=True, help="Repository name")
        p_wt_br.add_argument("--branch", required=True, help="Target git branch name")
        p_wt_br.add_argument("--task", help="Task ID (defaults to ambient task)")
        p_wt_br.add_argument("--force", action="store_true", help="Switch even if worktree has uncommitted changes")
        p_wt_br.add_argument("--json", action="store_true")

    # open
    p_open = sub.add_parser("open", help="Open linked resource(s) in browser or Slack desktop app")
    p_open.add_argument("selector", nargs="?", help="Category (jira, slack, pr, alert, doc) or ref/id")
    p_open.add_argument("--task", help="Task ID (defaults to ambient task)")

    # cleanup
    p_clean = sub.add_parser("cleanup", help="Audit git status, close Herdr workspace, remove worktrees, and archive task")
    p_clean.add_argument("task_id", nargs="?", help="Task ID (defaults to ambient task)")
    p_clean.add_argument("--force", action="store_true", help="Force removal even if worktrees have uncommitted changes")
    p_clean.add_argument("--delete-branches", action="store_true", help="Also delete local git branches")
    p_clean.add_argument("--no-herdr", action="store_true")
    p_clean.add_argument("--json", action="store_true")

    # sync-sidebar
    p_sync = sub.add_parser("sync-sidebar", help="Report $tickets metadata token to Herdr sidebar")
    p_sync.add_argument("--json", action="store_true")

    # popup
    sub.add_parser("popup", help="Launch interactive Mission Control fzf popup")

    # internal popup helper
    p_pa = sub.add_parser("_popup-action", help=argparse.SUPPRESS)
    p_pa.add_argument(
        "action",
        choices=[
            "cleanup",
            "add-repo",
            "pilot",
            "task-pilot",
            "edit-task",
            "set-status",
            "sync-task",
            "add-resource",
            "resources",
            "list-resources",
            "preview-resource",
            "preview-form",
            "preview-candidate",
            "open-resource",
            "edit-resource",
            "delete-resource",
        ],
    )
    p_pa.add_argument("task_id")
    p_pa.add_argument("resource_id", nargs="?", default=None)

    return p


def main(argv: list[str] | None = None) -> int:
    parser = build_parser()
    args = parser.parse_args(argv)
    paths = TaskPaths()
    cfg = load_config(paths)

    cmd = args.subcommand
    if cmd == "create":
        if getattr(args, "interactive", False):
            return interactive_task_form(paths, cfg, task_id=None, initial_args=args, no_herdr=getattr(args, "no_herdr", False))
        return cmd_create(args, paths, cfg)
    if cmd in ("update", "edit"):
        if getattr(args, "interactive", False):
            tid = resolve_current_task_id(paths, getattr(args, "task_id", None) or getattr(args, "task", None))
            return interactive_task_form(paths, cfg, task_id=tid, initial_args=args, no_herdr=getattr(args, "no_herdr", False))
        return cmd_update(args, paths, cfg)
    if cmd == "sync":
        return cmd_sync(args, paths, cfg)
    if cmd == "automations":
        return cmd_automations(args, paths, cfg)
    if cmd == "integrations":
        return cmd_integrations(args, paths, cfg)
    if cmd == "current":
        return cmd_current(args, paths, cfg)
    if cmd == "list":
        return cmd_list(args, paths, cfg)
    if cmd in ("status", "show"):
        return cmd_status(args, paths, cfg)
    if cmd in ("focus", "switch"):
        return cmd_focus(args, paths, cfg)
    if cmd == "link":
        if getattr(args, "interactive", False) or not getattr(args, "target", None):
            tid = resolve_current_task_id(paths, getattr(args, "task", None))
            if not tid:
                print("Error: could not resolve active task. Pass --task <id>.", file=sys.stderr)
                return 1
            return interactive_resource_form(tid, paths, cfg, initial_target=getattr(args, "target", None), no_herdr=getattr(args, "no_herdr", False))
        return cmd_link(args, paths, cfg)
    if cmd == "unlink":
        return cmd_unlink(args, paths, cfg)
    if cmd == "note":
        return cmd_note(args, paths, cfg)
    if cmd == "add":
        return cmd_add(args, paths, cfg)
    if cmd == "worktree" and getattr(args, "wt_subcommand", None) == "add":
        return cmd_worktree_add(args, paths, cfg)
    if cmd == "worktree" and getattr(args, "wt_subcommand", None) in ("branch", "switch"):
        return cmd_worktree_branch(args, paths, cfg)
    if cmd == "open":
        return cmd_open(args, paths, cfg)
    if cmd == "cleanup":
        return cmd_cleanup(args, paths, cfg)
    if cmd == "sync-sidebar":
        return cmd_sync_sidebar(args, paths, cfg)
    if cmd == "popup":
        return cmd_popup(args, paths, cfg)
    if cmd == "_popup-action":
        return cmd_popup_action(args, paths, cfg)

    parser.print_help()
    return 2


if __name__ == "__main__":
    sys.exit(main())
