#!/usr/bin/env python3
"""
herdr-task — Lightweight Task & Worktree Orchestrator for Multi-Repo Herdr Workspaces.

1 Herdr Workspace = 1 Task (HERDR_TASK_ID).
1 Tab = 1 Repo Git Worktree (4-pane Cockpit: code, agent, term, git).
"""

